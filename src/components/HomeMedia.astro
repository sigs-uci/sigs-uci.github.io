---
import { href, type Locale } from '../config/site';
import { tr, formatNumber } from '../i18n/ui';
import { publicMedia, mediaCollections, collectionPath, videoDuration } from '../lib/media';
import Video from './Video.astro';
import '../styles/editorial.css';
import '../styles/home-media.css';
const { locale = 'en' } = Astro.props as { locale: Locale };
const t = (text: string) => tr(locale, text);
const selected = [
  'nowruz-2017-photo-017', 'yalda-2018-kamyar-performance',
  'yalda-2019-photo-001', 'mehmooni-2018-photo-001',
  'welcome-2023-photo-002', 'beach-volleyball-2018-recap',
  'boat-outing-image-071', 'halloween-2018-photo-019',
  'yalda-2018-photo-015', 'nowruz-2019-photo-016',
  'nowruz-2019-k-von-invitation',
  'nowruz-2019-dance-rehearsal', 'community-meals-video-093',
  'bonfire-fall-2017-photo-007', 'football-gathering-recap',
  'iftar-2017-photo-003', 'taco-tuesday-2018-recap',
  'welcome-2018-community', 'yalda-2019-sandy-invitation',
  'yalda-2016-photo-011', 'community-meals-video-091',
  'poetry-night-2019-photo', 'beach-gatherings-video-050',
  'nowruz-2019-photo-010', 'beach-gatherings-image-083',
  'community-meals-image-110', 'community-meals-video-092',
  'costume-and-karaoke-image-087', 'watching-football-image-119',
  'innovation-forum-2018-community', 'yalda-2018-kamyar-invitation',
  'beach-gatherings-video-051', 'group-portraits-image-118',
  'community-meals-video-094', 'beach-gatherings-video-052',
  'indoor-community-gathering-image-073',
];
const moments = selected.flatMap(id => {
  const item = publicMedia.find(record => record.id === id);
  const collection = mediaCollections.find(record => record.mediaIds.includes(id));
  return item && collection ? [{ item, collection }] : [];
});
const photos = moments.filter(({ item }) => item.kind !== 'video');
---
<section class="wrap gathering-community" aria-labelledby="community-in-pictures" data-home-moments data-gallery>
  <div class="gathering-section-heading"><h2 id="community-in-pictures">{t('Dinner, celebrations and days out.')}</h2><a class="text-link" href={href(locale, 'community/memories')}>{t('More from our gatherings')} <span aria-hidden="true">↗</span></a></div>
  <a class="moments-skip sr-only" href="#newcomer-title" data-pagefind-ignore>{t('Continue past photos and videos')}</a>
  <div class="moments-toolbar">
    <p id="moments-help">{t('Scroll through the photos and play a video here. Open a photo for a closer look.')}</p>
    <div class="moments-controls" data-moments-controls hidden data-pagefind-ignore>
      <button type="button" data-moments-prev aria-label={t('Previous photo or video')} aria-controls="home-moments-track"><span aria-hidden="true">←</span></button>
      <bdi data-moments-count>{formatNumber(locale, 1)} / {formatNumber(locale, moments.length)}</bdi>
      <button type="button" data-moments-next aria-label={t('Next photo or video')} aria-controls="home-moments-track"><span aria-hidden="true">→</span></button>
    </div>
  </div>
  <div class="moments-track" id="home-moments-track" tabindex="0" role="region" aria-label={t('Photos and videos from SIGS gatherings')} aria-describedby="moments-help" data-moments-track>
    {moments.map(({ item, collection }) => {
      const caption = item.caption[locale];
      const credit = ['Photographer not recorded.', 'Videographer not recorded.'].includes(item.credit) ? undefined : t(item.credit);
      return <article class="moment" id={`home-moment-${item.id}`} data-moment>
        {item.kind === 'video' ? <Video item={item} locale={locale} /> : <figure class="moment-photo">
          <a href={item.src} data-gallery-item data-caption={[caption, credit].filter(Boolean).join(' ')}><img src={item.thumbnail ?? item.src} srcset={item.thumbnail ? `${item.thumbnail} 720w, ${item.src} ${item.width}w` : undefined} sizes="(max-width: 767px) 85vw, 680px" width={item.width} height={item.height} alt={item.alt[locale]} loading="lazy" /></a>
          <figcaption><p>{caption}</p><p class="moment-context">{collection.description[locale]}</p>{credit && <small>{credit}</small>}</figcaption>
        </figure>}
        <a class="moment-album" href={href(locale, collectionPath(collection))}>{collection.title[locale]} <span aria-hidden="true">↗</span></a>
      </article>;
    })}
  </div>
  <nav class="moments-thumbnails" aria-label={t('Choose a photo or video')} data-moments-thumbnails data-pagefind-ignore>
    {moments.map(({ item }, index) => <a href={`#home-moment-${item.id}`} data-moment-index={index} aria-label={`${t(item.kind === 'video' ? 'Video' : 'Photograph')}: ${item.caption[locale]}`}><img src={item.kind === 'video' ? item.videoPoster : item.thumbnail ?? item.src} width="96" height="72" alt="" loading="lazy" />{item.kind === 'video' && <span class="moment-thumbnail-video" aria-hidden="true"><svg width="16" height="16" viewBox="0 0 24 24"><path d="m8 4 12 8-12 8Z" fill="currentColor" /></svg><bdi dir="ltr">{videoDuration(item.duration ?? 0, locale)}</bdi></span>}</a>)}
  </nav>
  <p class="sr-only" data-moments-status role="status" aria-live="polite" aria-atomic="true" data-pagefind-ignore></p>
  {photos.length > 0 && <dialog class="gallery-dialog" aria-label={t('Image viewer')} data-pagefind-ignore><header><h2>{t('Photographs and posters')}</h2><button type="button" data-gallery-close autofocus>{t('Close')}</button></header><img src={photos[0].item.thumbnail ?? photos[0].item.src} alt="" loading="lazy" data-gallery-image /><p data-gallery-caption></p><p class="sr-only" data-gallery-status role="status" aria-live="polite" aria-atomic="true"></p><nav aria-label={t('Image controls')}><button type="button" data-gallery-prev>{t('Previous image')}</button><span data-gallery-count></span><button type="button" data-gallery-next>{t('Next image')}</button></nav></dialog>}
</section>
<script>
  import { setupGalleryLinks } from '../scripts/gallery-links';
  import { setupHomeMoments } from '../scripts/home-moments';
  document.querySelectorAll<HTMLElement>('[data-home-moments]').forEach(root => {
    setupGalleryLinks(root);
    setupHomeMoments(root);
  });
</script>
