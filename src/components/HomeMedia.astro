---
import { href, type Locale } from '../config/site';
import { tr, formatNumber } from '../i18n/ui';
import { publicMedia, mediaCollections, collectionPath, videoDuration, albumPageSize } from '../lib/media';
import { displayMediaCredit } from '../lib/media-credit';
import { buildHomeMediaRedirects } from '../scripts/home-media-redirects';
import Video from './Video.astro';
import '../styles/editorial.css';
import '../styles/home-media.css';
const { locale = 'en' } = Astro.props as { locale: Locale };
const t = (text: string) => tr(locale, text);
const selected = [
  'group-portraits-image-118', 'community-meals-image-110',
  'uci-mentoring-session-2024-video', 'boat-outing-image-071',
  'beach-gatherings-image-075', 'beach-volleyball-2018-recap',
  'costume-and-karaoke-image-085', 'welcome-2023-photo-002',
  'yalda-2023-archive-clip-04', 'yalda-2018-kamyar-performance',
  'nowruz-celebrations-image-022', 'poetry-night-2019-photo',
  'poetry-night-2019-tombak-video', 'iftar-2017-photo-003',
  'nowruz-2019-photo-010', 'halloween-2018-photo-019',
  'nowruz-2019-group-dance-clip-01', 'world-cup-iran-portugal-2018-gathering-clip-01',
  'iftar-2019-archive-clip-02', 'bonfire-2019-archive-photo-01',
];
const thumbnailWidths: Record<string, number> = {
  'welcome-2023-photo-002': 600, 'iftar-2017-photo-003': 600,
  'nowruz-2019-photo-010': 600, 'halloween-2018-photo-019': 600,
  'bonfire-2019-archive-photo-01': 540,
};
const moments = selected.flatMap(id => {
  const item = publicMedia.find(record => record.id === id);
  const collection = mediaCollections.find(record => record.mediaIds.includes(id));
  return item && collection ? [{ item, collection }] : [];
});
const photos = moments.filter(({ item }) => item.kind !== 'video');
const legacyRedirects = buildHomeMediaRedirects(selected, mediaCollections, publicMedia, locale, albumPageSize);
const legacyRedirectMap = Object.fromEntries(legacyRedirects.map(redirect => [redirect.hash, redirect.href]));
---
{legacyRedirects.length > 0 && <script type="application/json" data-home-media-redirects set:html={JSON.stringify(legacyRedirectMap).replaceAll('<', '\\u003c')} />}
<section class="wrap gathering-community" aria-labelledby="community-in-pictures" data-home-moments data-gallery>
  <div class="gathering-section-heading"><h2 id="community-in-pictures">{t('From our gatherings')}</h2><a class="text-link" href={href(locale, 'community/memories')}>{t('More from our gatherings')} <span aria-hidden="true">↗</span></a></div>
  <a class="moments-skip sr-only" href="#newcomer-title" data-pagefind-ignore>{t('Continue past photos and videos')}</a>
  <p class="sr-only" id="moments-help">{t('Scroll through the photos and play a video here. Open a photo for a closer look.')}</p>
  <div data-pagefind-ignore>{legacyRedirects.map(redirect => <p class="moment-legacy" id={redirect.hash.slice(1)}><a href={redirect.href}>{publicMedia.find(item => item.id === redirect.mediaId)?.caption[locale]} <span aria-hidden="true">↗</span></a></p>)}</div>
  <div class="moments-track" id="home-moments-track" tabindex="0" role="region" aria-label={t('Photos and videos from SIGS gatherings')} aria-describedby="moments-help" data-moments-track>
    {moments.map(({ item, collection }) => {
      const caption = item.caption[locale];
      const credit = displayMediaCredit(item.credit, locale);
      const [focusX, focusY] = item.focalPoint ?? [.5, .5];
      return <article class:list={['moment', { 'moment-full-frame': item.width / item.height > 1.5 || item.height > item.width }]} style={`--moment-focus:${focusX * 100}% ${focusY * 100}%`} id={`home-moment-${item.id}`} data-moment>
        {item.kind === 'video' ? <Video item={item} locale={locale} /> : <figure class="moment-photo">
          <a href={item.src} data-gallery-item data-caption={[caption, credit].filter(Boolean).join(' ')}><img src={item.thumbnail ?? item.src} srcset={item.thumbnail ? `${item.thumbnail} ${thumbnailWidths[item.id] ?? 720}w, ${item.src} ${item.width}w` : undefined} sizes="(max-width: 767px) 88vw, (max-width: 1023px) 70vw, 600px" width={item.width} height={item.height} alt={item.alt[locale]} loading="lazy" decoding="async" /></a>
          <figcaption><p>{caption}</p>{credit && <small dir="auto">{credit}</small>}</figcaption>
        </figure>}
        <a class="moment-album" href={href(locale, collectionPath(collection))}>{collection.title[locale]} <span aria-hidden="true">↗</span></a>
      </article>;
    })}
  </div>
  <div class="moments-navigation">
    <nav class="moments-thumbnails" aria-label={t('Choose a photo or video')} data-moments-thumbnails data-pagefind-ignore>
      {moments.map(({ item }, index) => <a href={`#home-moment-${item.id}`} data-moment-index={index} aria-label={`${t(item.kind === 'video' ? 'Video' : 'Photograph')}: ${item.caption[locale]}`} style={`--moment-focus:${(item.focalPoint?.[0] ?? .5) * 100}% ${(item.focalPoint?.[1] ?? .5) * 100}%`}><img src={item.kind === 'video' ? item.videoPoster : item.thumbnail ?? item.src} width="72" height="54" alt="" loading="lazy" />{item.kind === 'video' && <span class="moment-thumbnail-video" aria-hidden="true"><svg width="14" height="14" viewBox="0 0 24 24"><path d="m8 4 12 8-12 8Z" fill="currentColor" /></svg><bdi dir="ltr">{videoDuration(item.duration ?? 0, locale)}</bdi></span>}</a>)}
    </nav>
    <div class="moments-controls" data-moments-controls hidden data-pagefind-ignore>
      <button type="button" data-moments-prev aria-label={t('Previous photo or video')} aria-controls="home-moments-track"><span aria-hidden="true">←</span></button>
      <bdi data-moments-count>{formatNumber(locale, 1)} / {formatNumber(locale, moments.length)}</bdi>
      <button type="button" data-moments-next aria-label={t('Next photo or video')} aria-controls="home-moments-track"><span aria-hidden="true">→</span></button>
    </div>
  </div>
  <p class="sr-only" data-moments-status role="status" aria-live="polite" aria-atomic="true" data-pagefind-ignore></p>
  {photos.length > 0 && <dialog class="gallery-dialog" aria-label={t('Image viewer')} data-pagefind-ignore><header><h2>{t('Photographs and posters')}</h2><button type="button" data-gallery-close autofocus>{t('Close')}</button></header><img src={photos[0].item.thumbnail ?? photos[0].item.src} alt="" loading="lazy" data-gallery-image /><p data-gallery-caption></p><p class="sr-only" data-gallery-status role="status" aria-live="polite" aria-atomic="true"></p><nav aria-label={t('Image controls')}><button type="button" data-gallery-prev>{t('Previous image')}</button><span data-gallery-count></span><button type="button" data-gallery-next>{t('Next image')}</button></nav></dialog>}
</section>
<script>
  import { setupGalleryLinks } from '../scripts/gallery-links';
  import { setupHomeMoments } from '../scripts/home-moments';
  import { setupHomeMediaRedirects } from '../scripts/home-media-redirects';
  const legacyRedirects = document.querySelector<HTMLScriptElement>('[data-home-media-redirects]');
  if (legacyRedirects?.textContent) {
    try { setupHomeMediaRedirects(JSON.parse(legacyRedirects.textContent)); }
    catch {}
  }
  document.querySelectorAll<HTMLElement>('[data-home-moments]').forEach(root => {
    setupGalleryLinks(root);
    setupHomeMoments(root);
  });
</script>
