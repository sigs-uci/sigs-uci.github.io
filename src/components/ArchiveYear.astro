---
import { href, type Locale } from '../config/site';
import { archiveYears } from '../lib/archive';
import { tr, formatNumber } from '../i18n/ui';
import EventTeaser from './EventTeaser.astro';
import '../styles/editorial.css';
const { year, locale = 'en' } = Astro.props as { year: string; locale: Locale };
const years = archiveYears();
const selected = years.find(entry => entry.year === year)!;
const t = (s: string) => tr(locale, s);
const number = (value: number | string) => formatNumber(locale, Number(value));
---
<div class="wrap page-body">
  <nav class="breadcrumbs" aria-label={t('Breadcrumb')}><a href={href(locale, 'events')}>{t('Events')}</a><span aria-hidden="true">/</span><a href={href(locale, 'events/archive')}>{t('Archive')}</a><span aria-hidden="true">/</span><bdi>{number(year)}</bdi></nav>
  <nav class="year-directory" aria-label={t('Other years in the archive')}>{years.map(entry => <a href={href(locale, `events/archive/${entry.year}`)} aria-current={entry.year === year ? 'page' : undefined}><bdi>{number(entry.year)}</bdi><span>{number(entry.records.length)} {t(entry.records.length === 1 ? 'event' : 'events')}</span></a>)}</nav>
  <div class="record-directory">{selected.records.map(event => <EventTeaser event={event} locale={locale} level={2} />)}</div>
  <aside class="archive-help"><h2>{t('A detail to add?')}</h2><p>{t('Know the date of a gathering or have an old poster? Send the event link and the detail you can help us confirm.')}</p><a class="text-link" href={href(locale, 'contact')}>{t('Contact SIGS')} ↗</a><a class="text-link" href={href(locale, 'about/history')}>{t('Read the SIGS history')} ↗</a></aside>
</div>
