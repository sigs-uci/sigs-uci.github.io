---
import { href, type Locale } from '../config/site';
import { tr } from '../i18n/ui';
import { formatDate } from '../lib/events';
import { eventHref, eventLocale, reviewedTranslation } from '../lib/publication';
import { archiveYears } from '../lib/archive';
import { publicMedia, mediaCollections, collectionPath } from '../lib/media';
import HomeMedia from './HomeMedia.astro';
import HomeFeaturedEvent from './HomeFeaturedEvent.astro';
import '../styles/home.css';
const { locale = 'en' } = Astro.props as { locale: Locale };
const t = (text: string) => tr(locale, text);
const homeCollection = mediaCollections.find(collection => collection.id === 'boat-outing');
const homePhoto = publicMedia.find(item => item.id === 'boat-outing-image-068');
const collectionHref = href(locale, homeCollection ? collectionPath(homeCollection) : 'community/memories');
const archive = archiveYears().flatMap(entry => entry.records);
const memory = archive.find(event => event.id === 'poetry-night-2019') ?? archive[0];
const memoryTitle = memory && eventLocale(memory, locale) === 'fa' ? reviewedTranslation(memory.id)?.title : memory?.title;
const memorySummary = memory && eventLocale(memory, locale) === 'fa' ? reviewedTranslation(memory.id)?.summary : memory?.summary;
---
<div class="home-gathering">
  <section class="gathering-opening" aria-labelledby="home-title">
    <div class="wrap gathering-opening-grid">
      <div class="gathering-welcome">
      <h1 id="home-title"><bdi lang="en">SIGS</bdi> <span>{t('at UC Irvine')}</span></h1>
      <div class="gathering-introduction">
        <p>{t("We're the Iranian graduate student community at UC Irvine. Come to a gathering, or get in touch if you're new here.")}</p>
        <div class="gathering-actions"><a class="button gold" href={href(locale, 'events')}>{t('View events')}</a><a class="text-link" href={href(locale, 'join')}>{t('Say hello')}</a><a class="gathering-newcomer-link" href={href(locale, 'resources/new-students')}>{t('New to UCI? Start here')}</a></div>
      </div>
      </div>
      {homePhoto && <figure class="gathering-cover">
        <a href={collectionHref}><img src={homePhoto.src} srcset={homePhoto.thumbnail ? `${homePhoto.thumbnail} 720w, ${homePhoto.src} ${homePhoto.width}w` : undefined} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1190px) 55vw, 740px" width={homePhoto.width} height={homePhoto.height} alt={homePhoto.alt[locale]} loading="eager" fetchpriority="high" /></a>
        <figcaption><a href={collectionHref}>{homeCollection?.title[locale] ?? homePhoto.caption[locale]}</a>{homePhoto.credit !== 'Photographer not recorded.' && <span>{t(homePhoto.credit)}</span>}</figcaption>
      </figure>}
      <a class="gathering-mobile-newcomer" href={href(locale, 'resources/new-students')}>{t('New to UCI? Start here')}</a>
    </div>
  </section>

  <HomeFeaturedEvent locale={locale} />

  <HomeMedia locale={locale} />

  <section class="gathering-newcomers" aria-labelledby="newcomer-title"><div class="wrap">
    <div><h2 id="newcomer-title" tabindex="-1">{t('New to UCI?')}</h2><p>{t('Find arrival information, housing links, and someone at SIGS to ask about student life.')}</p></div>
    <nav aria-label={t('New student resources')}><a href={href(locale, 'resources/new-students')}>{t('Your first weeks at UCI')} <span aria-hidden="true">↗</span></a><a href={href(locale, 'resources')}>{t('Campus resources')} <span aria-hidden="true">↗</span></a><a href={href(locale, 'join')}>{t('Ask SIGS a question')} <span aria-hidden="true">↗</span></a></nav>
  </div></section>


  <section class="wrap gathering-history" aria-labelledby="history-title">
    <div><h2 id="history-title">{t('Earlier gatherings')}</h2><p>{t('Look back at our poetry nights, film screenings, Nowruz and Yalda celebrations.')}</p><a class="text-link" href={href(locale, 'events/archive')}>{t('Explore the event archive')} <span aria-hidden="true">↗</span></a></div>
    {memory && <article><time datetime={memory.date.value ?? undefined}><bdi>{formatDate(memory, locale)}</bdi></time><div><h3><a href={eventHref(memory, locale)} lang={eventLocale(memory, locale)}>{memoryTitle}</a></h3><p lang={eventLocale(memory, locale)}>{memorySummary}</p><a class="text-link" href={eventHref(memory, locale)}>{t('See event details')} <span aria-hidden="true">↗</span></a></div></article>}
  </section>

  <section class="gathering-collaborate" aria-labelledby="collaborate-title"><div class="wrap"><h2 id="collaborate-title">{t('Have an idea for a gathering?')}</h2><a class="text-link" href={href(locale, 'partners')}>{t('Talk with SIGS')} <span aria-hidden="true">↗</span></a></div></section>
</div>
