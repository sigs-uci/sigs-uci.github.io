---
import { href, emailLink, type Locale } from '../config/site';
import { tr, formatTerm } from '../i18n/ui';
import { boardTerms, events, organization } from '../data';
import { formatDate, nextEvent } from '../lib/events';
import { eventHref, eventLocale, reviewedTranslation } from '../lib/publication';
import { archiveYears } from '../lib/archive';
import { publicMedia, mediaCollections, collectionPath } from '../lib/media';
import HomeMedia from './HomeMedia.astro';
import '../styles/home.css';
const { locale = 'en' } = Astro.props as { locale: Locale };
const t = (text: string) => tr(locale, text);
const currentTeam = boardTerms.find(term => term.id === organization.currentBoardTermId);
const homeCollection = mediaCollections.find(collection => collection.id === 'boat-outing');
const homePhoto = publicMedia.find(item => item.id === 'boat-outing-image-068');
const collectionHref = href(locale, homeCollection ? collectionPath(homeCollection) : 'community/memories');
const archive = archiveYears().flatMap(entry => entry.records);
const memory = archive.find(event => event.id === 'poetry-night-2019') ?? archive[0];
const memoryTitle = memory && eventLocale(memory, locale) === 'fa' ? reviewedTranslation(memory.id)?.title : memory?.title;
const next = nextEvent(events);
const nextTitle = next && eventLocale(next, locale) === 'fa' ? reviewedTranslation(next.id)?.title : next?.title;
---
<div class="home-gathering">
  <section class="gathering-opening" aria-labelledby="home-title">
    <div class="wrap gathering-opening-grid">
      <h1 id="home-title">{locale === 'fa' ? <>{t('With')} <bdi lang="en">SIGS</bdi> <span>{t('Get to know us.')}</span></> : <>{t('Meet')} <span><bdi lang="en">SIGS.</bdi></span></>}</h1>
      <div class="gathering-introduction">
        <p>{t('The Iranian graduate student community at UC Irvine.')}</p>
        <div class="gathering-actions"><a class="button gold" href={href(locale, 'join')}>{t('Say hello')}</a><a class="gathering-newcomer-link" href={href(locale, 'resources/new-students')}>{t('New to UCI? Start here')}</a></div>
      </div>
      {homePhoto && <figure class="gathering-cover">
        <a href={collectionHref}><img src={homePhoto.src} srcset={homePhoto.thumbnail ? `${homePhoto.thumbnail} 720w, ${homePhoto.src} ${homePhoto.width}w` : undefined} sizes="(max-width: 767px) calc(100vw - 40px), (max-width: 1190px) calc(100vw - 64px), min(1280px, 100vw - 96px)" width={homePhoto.width} height={homePhoto.height} alt={homePhoto.alt[locale]} loading="eager" fetchpriority="high" /></a>
        <figcaption><a href={collectionHref}>{t('Out on the water')} <span aria-hidden="true">↗</span></a>{homePhoto.credit !== 'Photographer not recorded.' && <span>{t(homePhoto.credit)}</span>}</figcaption>
      </figure>}
      <a class="gathering-mobile-newcomer" href={href(locale, 'resources/new-students')}>{t('New to UCI? Start here')}</a>
    </div>
  </section>

  <section class="wrap gathering-next" aria-labelledby="next-title">
    <h2 id="next-title">{t('The next gathering')}</h2>
    {next ? <><div><h3 lang={eventLocale(next, locale)}>{nextTitle}</h3><p><bdi>{formatDate(next, locale)}</bdi>{next.timeDisplay && ` · ${t(next.timeDisplay)}`}{next.venue && ` · ${t(next.venue)}`}</p></div><a class="text-link" href={eventHref(next, locale)}>{t('Event details')} <span aria-hidden="true">↗</span></a></> : <><p>{t('No new date is posted yet. Contact the team to ask about taking part or helping organize.')}</p><a class="text-link" href={emailLink(t('Connect with SIGS'))}>{t('Email the team')}</a></>}
  </section>

  <HomeMedia locale={locale} />

  <section class="gathering-newcomers" aria-labelledby="newcomer-title"><div class="wrap">
    <div><h2 id="newcomer-title">{t('New to UCI?')}</h2><p>{t('Find the campus information you need, and get in touch with SIGS.')}</p></div>
    <nav aria-label={t('New student resources')}><a href={href(locale, 'resources/new-students')}>{t('Your first weeks at UCI')} <span aria-hidden="true">↗</span></a><a href={href(locale, 'resources')}>{t('Campus resources')} <span aria-hidden="true">↗</span></a><a href={href(locale, 'join')}>{t('Ask SIGS a question')} <span aria-hidden="true">↗</span></a></nav>
  </div></section>

  {currentTeam && <section class="wrap gathering-team" aria-labelledby="team-title">
    <div class="gathering-section-heading"><div><h2 id="team-title">{t('The people behind SIGS.')}</h2><p class="gathering-term"><bdi>{formatTerm(locale, currentTeam.term)}</bdi> / {t('Leadership & Team')}</p></div><a class="text-link" href={href(locale, 'about/leadership')}>{t('Meet the team')} <span aria-hidden="true">↗</span></a></div>
    <div class="gathering-team-list">{currentTeam.people.slice().sort((a, b) => a.displayOrder - b.displayOrder).map(member => <a href={`${href(locale, 'about/leadership')}#${member.personId}`}><strong><bdi lang="en" dir="ltr">{member.name}</bdi></strong><span>{t(member.role)}</span></a>)}</div>
  </section>}

  <section class="wrap gathering-history" aria-labelledby="history-title">
    <div><h2 id="history-title">{t('Earlier gatherings')}</h2><p>{t('Poetry, film, Nowruz and Yalda are part of the SIGS story.')}</p><a class="text-link" href={href(locale, 'events/archive')}>{t('Explore the event archive')} <span aria-hidden="true">↗</span></a></div>
    {memory && <article><time datetime={memory.date.value ?? undefined}><bdi>{formatDate(memory, locale)}</bdi></time><div><h3><a href={eventHref(memory, locale)} lang={eventLocale(memory, locale)}>{memoryTitle}</a></h3><p>{t(memory.archiveLabel ?? memory.eventState)}</p><a class="text-link" href={eventHref(memory, locale)}>{t('See event details')} <span aria-hidden="true">↗</span></a></div></article>}
  </section>

  <section class="gathering-collaborate" aria-labelledby="collaborate-title"><div class="wrap"><h2 id="collaborate-title">{t('Have an idea for a gathering?')}</h2><a class="text-link" href={href(locale, 'partners')}>{t('Talk with SIGS')} <span aria-hidden="true">↗</span></a></div></section>
</div>
