---
import { href, type Locale } from '../config/site';
import { tr, formatNumber, formatTerm } from '../i18n/ui';
import { boardTerms, events, media, organization, programs } from '../data';
import { formatDate, nextEvent } from '../lib/events';
import { eventHref, eventLocale, reviewedTranslation } from '../lib/publication';
import { archiveYears } from '../lib/archive';
import EventTeaser from './EventTeaser.astro';
import HomeMedia from './HomeMedia.astro';
import {mediaCollections,collectionPath} from '../lib/media';
import '../styles/editorial.css';
const { locale = 'en' } = Astro.props as {locale:Locale};
const t = (s:string) => tr(locale,s);
const years = archiveYears();
const archive = years.flatMap(entry => entry.records);
const selected = archive.slice(0, 4);
const currentTeam = boardTerms.find(term => term.id === organization.currentBoardTermId);
const homeCollection=mediaCollections.find(collection=>collection.id==='community-meals');
const homePhoto = media.find(image => image.id === homeCollection?.coverId && image.publication === 'published' && image.rights === 'approved');
const next = nextEvent(events);
const nextTitle = next && eventLocale(next,locale)==='fa' ? reviewedTranslation(next.id)?.title : next?.title;
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy"><p class="eyebrow">{t('Iranian graduate life at UC Irvine')}</p><h1>{t('See you at')} <span><bdi>SIGS.</bdi></span></h1><p class="hero-intro">{t("We're the Iranian graduate student community at UC Irvine. Come to a gathering, or get in touch if you're new here.")}</p><div class="actions"><a class="button primary" href={href(locale,'events')}>{t('Explore events')} <span aria-hidden="true">↗</span></a><a class="button outline" href={href(locale,'join')}>{t('Join SIGS')}</a></div><p class="hero-footnote">{t('A familiar hello. A new connection.')}</p></div>
    {homePhoto ? <figure class="hero-photo"><p class="eyebrow">{t('Around the table')}</p><a href={href(locale,homeCollection?collectionPath(homeCollection):'community/memories')}><img src={homePhoto.thumbnail??homePhoto.src} srcset={homePhoto.thumbnail?`${homePhoto.thumbnail} 720w, ${homePhoto.src} ${homePhoto.width}w`:undefined} sizes="(max-width: 767px) calc(100vw - 48px), 45vw" width={homePhoto.width} height={homePhoto.height} alt={homePhoto.alt[locale]??homePhoto.alt.en??''} loading="eager" fetchpriority="high" /></a><figcaption><a href={href(locale,homeCollection?collectionPath(homeCollection):'community/memories')}>{t('A meal, and a chance to catch up.')} ↗</a><span>{t('From the community photo collection')} · {t(homePhoto.credit)}</span></figcaption></figure> : <div class="hero-art" aria-hidden="true"><div class="art-outline"></div><div class="art-main"><span class="art-label">IRVINE, CALIFORNIA / SIGS</span><span class="persian-display" lang="fa" dir="rtl">کنار<br />هم</span><span class="art-baseline">Room for connection.</span></div><div class="art-note"><span>GOOD COMPANY.<br />SHARED MOMENTS.</span><span class="art-arrow">↗</span></div><span class="art-coordinate">UC IRVINE / CALIFORNIA</span></div>}
  </div>
</section>
<nav class="wrap home-facts" aria-label={t('Explore the SIGS records')}><a href={href(locale,'events/archive')}><strong>{formatNumber(locale,archive.length)}</strong> {t('event records')}</a><a href={href(locale,'community')}><strong>{formatNumber(locale,programs.length)}</strong> {t('program themes')}</a><a href={href(locale,'about/leadership')}><strong>{formatNumber(locale,currentTeam?.people.length ?? 0)}</strong> {t('current team members')}</a><a href={href(locale,'resources/new-students')}>{t('New to UCI? Start here')} ↗</a></nav>
<HomeMedia locale={locale}/>
<section class="section wrap" aria-labelledby="next-title">
  <div class="section-heading"><div><p class="eyebrow">{t('Events at SIGS')}</p><h2 id="next-title">{t(next ? 'Make room for a gathering.' : 'A community, in its own record.')}</h2></div><a class="text-link" href={href(locale,'events')}>{t('All events')} <span aria-hidden="true">↗</span></a></div>
  {next && <div class="next-panel"><div><p class="eyebrow">{t("What's next")}</p><h3>{nextTitle}</h3><p><bdi>{formatDate(next,locale)}</bdi>{next.timeDisplay&&` · ${t(next.timeDisplay)}`}{next.venue&&` · ${t(next.venue)}`}</p></div><a class="button light" href={eventHref(next,locale)}>{t('Event details')} <span aria-hidden="true">↗</span></a></div>}
  <div class="home-archive-intro"><div><h3>{t('Celebrations, conversations, and campus life.')}</h3><p>{t('The archive brings together Nowruz and Yalda, film and poetry, newcomer welcomes, professional events, and community gatherings. Start with the recent records or choose a year below.')}</p><a class="text-link" href={href(locale,'events/archive')}>{t('Browse the full archive')} ↗</a></div>{!next && <aside class="notice"><h3>{t('Looking for the next gathering?')}</h3><p>{t('A new date will appear when its details are confirmed. Email the team to ask about taking part or helping organize.')}</p><a class="text-link" href={href(locale,'join')}>{t('Get in touch')} ↗</a></aside>}</div>
  <div class="record-directory">{selected.map(event => <EventTeaser event={event} locale={locale} />)}</div>
  <p class="archive-note">{t('A documented gathering has supporting occurrence evidence. An archived announcement preserves advertised plans.')}</p>
</section>
<section class="newcomer-band"><div class="wrap two-col"><div><p class="eyebrow">{t('New to UCI?')}</p><h2>{t('A new campus.')}<br />{t('A familiar welcome.')}</h2><p>{t('Start with the practical things. Then find the people who make a place feel like yours.')}</p></div><nav class="task-links" aria-label={t('New student resources')}><a href={href(locale,'resources/new-students')}>{t('Your first weeks at UCI')} <span aria-hidden="true">↗</span></a><a href={href(locale,'resources')}>{t('Campus support & essentials')} <span aria-hidden="true">↗</span></a><a href={href(locale,'join')}>{t('Connect with SIGS')} <span aria-hidden="true">↗</span></a></nav></div></section>
<section class="section wrap" aria-labelledby="history-title"><div class="section-heading"><div><p class="eyebrow">{t('Our shared history')}</p><h2 id="history-title">{t('Find your year. Follow a thread.')}</h2></div><a class="text-link" href={href(locale,'about/history')}>{t('Read the history')} <span aria-hidden="true">↗</span></a></div><nav class="year-directory" aria-label={t('Archive by year')}>{years.map(entry=><a href={href(locale,`events/archive/${entry.year}`)}><bdi>{formatNumber(locale,Number(entry.year))}</bdi><span>{formatNumber(locale,entry.records.length)} {t(entry.records.length === 1 ? 'record' : 'records')}</span></a>)}</nav><div class="program-index">{programs.map(program=><article><p class="eyebrow">{t(program.period)}</p><h3><a href={href(locale,`community/programs/${program.id}`)}>{t(program.name)} ↗</a></h3><p>{t(program.summary)}</p></article>)}</div><p class="archive-note">{t('These themes describe activities in the SIGS record. They do not announce a current schedule.')}</p></section>
{currentTeam && <section class="home-team" aria-labelledby="home-team-title"><div class="wrap home-team-grid"><div class="home-team-copy"><p class="eyebrow">{t('Leadership & Team')} / <bdi dir="ltr">{formatTerm(locale,currentTeam.term)}</bdi></p><h2 id="home-team-title">{t('Meet the people behind SIGS.')}</h2><p>{t('Meet the people serving SIGS this term. Find their roles and term-specific contacts on the team page.')}</p><a class="text-link" href={href(locale,'about/leadership')}>{t('Meet the current team')} ↗</a></div><div class="home-team-names">{currentTeam.people.slice().sort((a,b)=>a.displayOrder-b.displayOrder).map(member=><a href={`${href(locale,'about/leadership')}#${member.personId}`}><strong><bdi lang="en" dir="ltr">{member.name}</bdi></strong><span>{t(member.role)}</span></a>)}</div></div></section>}
<section class="wrap partnership-home"><div><p class="eyebrow">{t('Partner with SIGS')}</p><h2>{t('Help good things')}<br />{t('happen.')}</h2></div><div><p>{t('Have an idea for a cultural gathering, a newcomer welcome, or a professional conversation? Start a conversation with us.')}</p><a class="button navy" href={href(locale,'partners')}>{t('Talk about a collaboration')} <span aria-hidden="true">↗</span></a></div></section>
<section class="section wrap join-home"><div><p class="eyebrow">{t('Take part')}</p><h2>{t('See a familiar face.')}<br />{t('Meet someone new.')}</h2><p>{t('Come to a gathering or help make the next one happen.')}</p></div><a class="button primary" href={href(locale,'join')}>{t('Join SIGS')} <span aria-hidden="true">↗</span></a></section>
