---
import { href, type Locale } from '../config/site';
import { tr } from '../i18n/ui';
import { events, type EventRecord } from '../data';
import { formatDate, isPublicEvent, nextEvent } from '../lib/events';
import { eventHref, eventLocale, reviewedTranslation } from '../lib/publication';
const { locale = 'en' } = Astro.props as {locale:Locale};
const t = (s:string) => tr(locale,s);
const selected = ['yalda-2015','nowruz-2018','poetry-night-2019'].map(id => events.find(e => e.id === id)).filter((event):event is EventRecord => Boolean(event && isPublicEvent(event)));
const next = nextEvent(events);
const nextTitle = next && eventLocale(next,locale)==='fa' ? reviewedTranslation(next.id)?.title : next?.title;
const eventLink = (id:string) => {const event=events.find(record=>record.id===id&&isPublicEvent(record));return event?eventHref(event,locale):href(locale,'events/archive');};
---
<section class="hero">
  <div class="wrap hero-grid">
    <div class="hero-copy"><p class="eyebrow">{t('Iranian graduate life at UC Irvine')}</p><h1>{t('See you at')} <span><bdi>SIGS.</bdi></span></h1><p class="hero-intro">{t("We're the Iranian graduate student community at UC Irvine. Come to a gathering, or get in touch if you're new here.")}</p><div class="actions"><a class="button primary" href={href(locale,'events')}>{t('Explore events')} <span aria-hidden="true">↗</span></a><a class="button outline" href={href(locale,'join')}>{t('Join SIGS')}</a></div><p class="hero-footnote">{t('A familiar hello. A new connection.')}</p></div>
    <div class="hero-art" aria-hidden="true"><div class="art-outline"></div><div class="art-main"><span class="art-label">IRVINE, CALIFORNIA / SIGS</span><span class="persian-display" lang="fa" dir="rtl">کنار<br />هم</span><span class="art-baseline">Room for connection.</span></div><div class="art-note"><span>GOOD COMPANY.<br />SHARED MOMENTS.</span><span class="art-arrow">↗</span></div><span class="art-coordinate">UC IRVINE / CALIFORNIA</span></div>
  </div>
</section>
<section class="section wrap" aria-labelledby="next-title">
  <div class="section-heading"><div><p class="eyebrow">{t("What's next")}</p><h2 id="next-title">{t('Make room for a gathering.')}</h2></div><a class="text-link" href={href(locale,'events')}>{t('All events')} <span aria-hidden="true">↗</span></a></div>
  <div class="next-panel"><span class="calendar-mark" aria-hidden="true"><svg width="42" height="42" viewBox="0 0 40 40" fill="none"><rect x="5" y="8" width="30" height="28" rx="4" stroke="currentColor" stroke-width="2"/><path d="M5 16h30M13 3v10M27 3v10M12 23h5m6 0h5M12 29h5" stroke="currentColor" stroke-width="2"/></svg></span>{next?<><div><h3>{nextTitle}</h3><p><bdi>{formatDate(next,locale)}</bdi>{next.timeDisplay&&` · ${next.timeDisplay}`}{next.venue&&` · ${next.venue}`}</p></div><a class="button light" href={eventHref(next,locale)}>{t('Event details')} <span aria-hidden="true">↗</span></a></>:<><div><h3>{t('The next gathering starts here.')}</h3><p>{t('Details will appear when confirmed. Until then, say hello to the team or take a look at past gatherings.')}</p></div><a class="button light" href={href(locale,'join')}>{t('Get in touch')} <span aria-hidden="true">↗</span></a></>}</div>
</section>
<section class="section community-home wrap" aria-labelledby="life-title">
  <div class="section-heading"><div><p class="eyebrow">{t('Life in SIGS')}</p><h2 id="life-title">{t('A community beyond')}<br />{t('the classroom.')}</h2></div><a class="text-link" href={href(locale,'community')}>{t('Meet the community')} <span aria-hidden="true">↗</span></a></div>
  <div class="community-mosaic"><a class="celebration" href={eventLink('nowruz-2018')}><span class="eyebrow">{t('Gather around a tradition')}</span><span class="large-persian" lang="fa" dir="rtl" aria-hidden="true">نوروز</span><div><h3>{t('A new year, together.')}</h3><p>{t('Nowruz celebrations are part of the SIGS story. Return to March 2018.')}</p></div><span class="corner-arrow" aria-hidden="true">↗</span></a><div class="mosaic-side"><a class="conversation" href={eventLink('poetry-night-2019')}><span class="eyebrow">{t('A smaller circle')}</span><h3>{t('An evening of poetry.')}</h3><p>{t('Persian Poetry Night, February 2019.')}</p><span class="corner-arrow" aria-hidden="true">↗</span></a><a class="film" href={eventLink('tales-2016')}><span class="eyebrow">{t('Film & conversation')}</span><h3><i>Tales</i></h3><p>{t('A screening and Q&A advertised in March 2016.')}</p><span class="corner-arrow" aria-hidden="true">↗</span></a></div></div>
</section>
<section class="newcomer-band"><div class="wrap two-col"><div><p class="eyebrow">{t('New to UCI?')}</p><h2>{t('A new campus.')}<br />{t('A familiar welcome.')}</h2><p>{t('Start with the practical things. Then find the people who make a place feel like yours.')}</p></div><nav class="task-links" aria-label={t('New student resources')}><a href={href(locale,'resources/new-students')}>{t('Your first weeks at UCI')} <span aria-hidden="true">↗</span></a><a href={href(locale,'resources')}>{t('Campus support & essentials')} <span aria-hidden="true">↗</span></a><a href={href(locale,'join')}>{t('Connect with SIGS')} <span aria-hidden="true">↗</span></a></nav></div></section>
<section class="section wrap" aria-labelledby="history-title"><div class="section-heading"><div><p class="eyebrow">{t('Our shared history')}</p><h2 id="history-title">{t('A few places to begin.')}</h2></div><a class="text-link" href={href(locale,'events/archive')}>{t('Explore the archive')} <span aria-hidden="true">↗</span></a></div><div class="history-home">{selected.map(event => <a class="history-entry" href={eventHref(event,locale)} lang={eventLocale(event,locale)}><time datetime={event.date.value ?? undefined}>{formatDate(event,locale)}</time><h3>{eventLocale(event,locale)==='fa'?reviewedTranslation(event.id)?.title:event.title}</h3><span class="quiet">{t(event.archiveLabel??event.eventState)}</span><span class="entry-arrow" aria-hidden="true">↗</span></a>)}</div><p class="archive-note">{t('The archive holds both documented gatherings and archived announcements. Each record keeps that distinction.')}</p></section>
<section class="wrap partnership-home"><div><p class="eyebrow">{t('Partner with SIGS')}</p><h2>{t('Help good things')}<br />{t('happen.')}</h2></div><div><p>{t('Have an idea for a cultural gathering, a newcomer welcome, or a professional conversation? Start a conversation with us.')}</p><a class="button navy" href={href(locale,'partners')}>{t('Talk about a collaboration')} <span aria-hidden="true">↗</span></a></div></section>
<section class="section wrap join-home"><div><p class="eyebrow">{t('Take part')}</p><h2>{t('See a familiar face.')}<br />{t('Meet someone new.')}</h2><p>{t('Come to a gathering or help make the next one happen.')}</p></div><a class="button primary" href={href(locale,'join')}>{t('Join SIGS')} <span aria-hidden="true">↗</span></a></section>
