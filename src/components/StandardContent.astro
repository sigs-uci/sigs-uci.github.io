---
import { href, emailLink, site, type Locale } from '../config/site';
import { tr, formatNumber, formatTerm, formatDay } from '../i18n/ui';
import { boardTerms, events, milestones, organization, programs, resources, stories, type EventRecord } from '../data';
import CollectionDirectory from './CollectionDirectory.astro';
import {mediaCollections,publicMedia} from '../lib/media';
import { isPublicEvent, newestEventsFirst } from '../lib/events';
import { eventHref, eventLocale, isPublicStory, reviewedTranslation } from '../lib/publication';
import '../styles/editorial.css';
import { cloudflareWebAnalyticsSiteId } from '../config/analytics';
import { analyticsSiteId } from '../lib/analytics';

const { locale = 'en', path } = Astro.props as { locale: Locale; path: string };
const t = (text: string) => tr(locale, text);
const analyticsEnabled = analyticsSiteId(cloudflareWebAnalyticsSiteId) !== null;
const publishedEvent = (id: string) => events.find(event => event.id === id && isPublicEvent(event));
const eventTitle = (event: EventRecord) => eventLocale(event, locale) === 'fa' ? reviewedTranslation(event.id)?.title ?? event.title : event.title;
const contextEvent = (path: string) => events.find(event => path === `events/${event.slug}` && isPublicEvent(event));
const contextLink = (path: string) => {
  if (!path.startsWith('events/')) return href(locale, path);
  const event = contextEvent(path);
  return event ? eventHref(event, locale) : href(locale, 'events/archive');
};
const contextLanguage = (path: string) => { const event = contextEvent(path); return event ? eventLocale(event, locale) : locale; };
const contextLabel = (path: string, label: string) => t(path.startsWith('events/') && !contextEvent(path) ? 'Browse the event archive' : label);
const communityStories = stories.filter(story => story.locale === locale && isPublicStory(story));
const currentTeam = boardTerms.find(term => term.id === organization.currentBoardTermId);
const previousTeam = boardTerms.filter(term => term.status === 'former').sort((a, b) => b.id.localeCompare(a.id))[0];
const communityPhoto = publicMedia.find(item => item.id === 'boat-outing-image-071');
const resourceGroups = [
  { id: 'arriving', title: 'Before you arrive', summary: 'UCI checklists and contacts for arriving students.' },
  { id: 'settling-in', title: 'Housing and campus setup', summary: 'Housing options and the campus tools you need when you arrive.' },
  { id: 'campus', title: 'Around campus', summary: 'Find your building and plan how to get there.' },
  { id: 'support', title: 'Support when you need it', summary: 'Contact the campus service that can help with your question.' },
  { id: 'connections', title: 'Your graduate community', summary: 'Graduate workshops, student representation, and activities beyond your department.' },
];
const contactRoutes = [
  { title: 'Join or say hello', text: 'Ask about joining SIGS, coming to an event, or settling into life at UCI.', subject: 'Connect with SIGS', action: 'Ask about taking part' },
  { title: 'Plan a collaboration', text: 'Have an idea for an event or want to work with SIGS? Tell us what you have in mind.', subject: 'SIGS collaboration inquiry', action: 'Discuss an idea' },
  { title: 'Correct the archive', text: 'Send the page link and what needs changing. If you include a photo or document, tell us whether we may publish it.', subject: 'SIGS archive correction', action: 'Send a correction' },
  { title: 'Ask about a photograph', text: 'For a photo question or removal request, include the page and a description of the image. Please avoid sending information about other attendees.', subject: 'SIGS photo request', action: 'Contact us about an image' },
  { title: 'Report an access barrier', text: 'Describe the page or event and the help you need. For a website problem, your browser and device type can help us understand it.', subject: 'SIGS accessibility request', action: 'Ask for accessibility help' },
];
---

<div class="wrap page-body standard-page">
  {path === 'community' && <>
    <section class="feature-type community-feature" aria-labelledby="community-together">
      <div><p class="eyebrow">{t('Life in SIGS')}</p><h2 id="community-together">{t('Get together with SIGS.')}</h2><p>{t(organization.description)}</p><a class="button light" href={href(locale, 'join')}>{t('Join a gathering')}</a></div>
      {communityPhoto?<figure><a href={href(locale,'community/memories/boat-outing')}><img src={communityPhoto.src} width={communityPhoto.width} height={communityPhoto.height} alt={communityPhoto.alt[locale]} /></a><figcaption><a href={href(locale,'community/memories/boat-outing')}>{mediaCollections.find(collection => collection.id === 'boat-outing')?.title[locale] ?? communityPhoto.caption[locale]} <span aria-hidden="true">↗</span></a></figcaption></figure>:<div class="persian-display" aria-hidden="true">SIGS</div>}
    </section>
    <section class="section" aria-labelledby="community-images"><div class="section-heading"><div><p class="eyebrow">{t('Photo collections')}</p><h2 id="community-images">{t('Photos from SIGS gatherings.')}</h2></div><a class="text-link" href={href(locale,'community/memories')}>{t('Explore every collection')} ↗</a></div><CollectionDirectory locale={locale} collections={mediaCollections.slice(0,6)}/><a class="button primary" href={href(locale,'community/videos')}>{t('Watch all videos')} ↗</a></section>
    <div class="program-list">{programs.map(program => <section class="program"><p class="eyebrow">{t(program.period)}</p><h2><a href={href(locale, `community/programs/${program.id}`)}>{t(program.name)}</a></h2><p>{t(program.summary)}</p><a class="text-link" href={href(locale, `community/programs/${program.id}`)}>{t('About the program')} <span aria-hidden="true">↗</span></a></section>)}</div>
    <section class="notice"><h2>{t('Have an idea for our next event?')}</h2><p>{t('Suggest an activity, help organize an event, or share a photo from a past gathering. Email the team to get started.')}</p><div class="subnav"><a href={href(locale, 'community/memories')}>{t('Explore memories')}</a><a href={emailLink(t('Take part in SIGS'))}>{t('Offer an idea or a hand')}</a></div></section>
  </>}

  {(path === 'resources' || path === 'resources/new-students') && <>
    <nav class="resource-guide-nav" aria-labelledby="resource-guide-heading"><h2 id="resource-guide-heading">{t('In this guide')}</h2><div>{resourceGroups.map(group=><a href={`#${group.id}`}>{t(group.title)} <span aria-hidden="true">↓</span></a>)}<a href="#connect-with-sigs">{t('Connect with SIGS')} <span aria-hidden="true">↓</span></a></div></nav>
    {path === 'resources/new-students' && <section class="prose"><h2>{t('Start with the practical things.')}</h2><p>{t('Moving to UCI comes with plenty of questions. Start with the official links below for arrival requirements, housing, and campus services. For everyday questions about student life, you can ask SIGS.')}</p><p>{t('For immigration, health requirements, housing eligibility, or financial rules, contact the relevant UCI office. This guide helps you find those offices.')}</p></section>}
    {path === 'resources' && <section class="prose"><p>{t('Find the UCI office or service you need below. Each link goes to the official university page.')}</p><p class="quiet">{formatNumber(locale,resources.length)} {t('official campus resources, grouped by what you need to do.')}</p><a class="text-link" href={href(locale, 'resources/new-students')}>{t('New here? Start with the newcomer guide')} <span aria-hidden="true">↗</span></a></section>}
    {path === 'resources/new-students' && <div class="newcomer-route"><section><p class="eyebrow">{t('Before arrival')}</p><h2>{t('Plan your arrival.')}</h2><p>{t('Check the arrival requirements and housing options before planning your move.')}</p><ul><li><a href="#arriving">{t('Arrival and the International Center')}</a></li><li><a href="#housing">{t('Graduate and family housing')}</a></li></ul></section><section><p class="eyebrow">{t('Your first weeks')}</p><h2>{t('Get oriented on campus.')}</h2><p>{t('Find your building, look up transport, and get your campus technology working. Read the current new-student health information.')}</p><ul><li><a href="#campus">{t('Maps, transport, and campus services')}</a></li><li><a href="#student-health">{t('New-student health information')}</a></li><li><a href="#graduate-technology">{t('Campus technology')}</a></li></ul></section><section><p class="eyebrow">{t('As you settle in')}</p><h2>{t('Find people and support.')}</h2><p>{t('Meet other graduate students, see what is happening on campus, and find writing or career support when you need it.')}</p><ul><li><a href="#connections">{t('Graduate workshops and connections')}</a></li><li><a href="#support">{t('Campus support services')}</a></li><li><a href="#connect-with-sigs">{t('Say hello to SIGS')}</a></li></ul></section></div>}
    <div class="resource-guide-content">{resourceGroups.map(group => <section class="resource-list" id={group.id} aria-labelledby={`${group.id}-heading`}><h2 id={`${group.id}-heading`}>{t(group.title)}</h2><p class="quiet">{t(group.summary)}</p>{resources.filter(resource => resource.category === group.id).map(resource => <article class="resource-item" id={resource.id}><h3><a href={resource.url}>{t(resource.title)} <span aria-hidden="true">↗</span></a></h3><p>{t(resource.description)}</p><small>{t(resource.source)}<br />{t('Link and description checked')}: <time datetime={resource.reviewedOn}>{formatDay(locale,resource.reviewedOn)}</time> · {t(resource.ownerRole)}</small></article>)}<a class="resource-guide-back" href="#resource-guide-heading">{t('Back to guide topics')} <span aria-hidden="true">↑</span></a></section>)}</div>
    <section class="notice" id="connect-with-sigs"><h2>{t('Questions about life at UCI?')}</h2><p>{t('You do not need to wait for an event to say hello. Email SIGS, introduce yourself, and ask what you would like to know. Check each event page for eligibility and signup details.')}</p><a class="button primary" href={emailLink(t('New to UCI and SIGS'))}>{t('Say hello to SIGS')}</a></section>
    <p class="archive-note">{t('The SIGS team checks these links and descriptions on the dates shown. For advice about your situation, contact the relevant office. Found a broken link?')} <a href={emailLink(t('SIGS resource correction'))}>{t('Send a correction.')}</a></p>
  </>}

  {path === 'about' && <div class="aside-layout">
    <article class="prose"><h2>{t('What we do.')}</h2><p>{t(organization.description)}</p><p>{t('Our activities have included Nowruz and Yalda celebrations, film screenings, poetry nights, casual get-togethers, and welcomes for new students. We have also worked with campus and community partners.')}</p><h2>{t('A student organization at UC Irvine.')}</h2><p>{t('SIGS is a registered UCI student organization for 2026-2027. We confirmed that status on October 22, 2026. Our team maintains this website.')}</p><p>{t('Ask the team about joining SIGS or attending a gathering. Membership and event participation have separate requirements, so check the details for each event.')}</p><h2>{t('The teams who keep SIGS going.')}</h2><p>{t('Meet the current team and explore the people who served in earlier terms.')}</p><p class="quiet">{t('Current term')}: <bdi dir="ltr">{formatTerm(locale,currentTeam?.term ?? organization.currentBoardTermId)}</bdi></p><div class="subnav"><a href={href(locale, 'about/leadership')}>{t('Meet the current team')}</a>{previousTeam && <a href={href(locale, `about/leadership/${previousTeam.id}`)}>{t('The previous team')}</a>}<a href={href(locale, 'about/history')}>{t('Read our history')}</a></div></article>
    <aside class="callout"><h2>{t('Keep in touch.')}</h2><p>{t('Ask about SIGS, suggest a gathering, or tell us what you would like to help with.')}</p><a class="button navy" href={emailLink(t('Hello SIGS'))}>{t('Email SIGS')}</a><p style="margin-top:16px"><bdi>{site.email}</bdi></p></aside>
  </div>}

  {path === 'about/history' && <>
    <section class="prose"><p>{t('The archive is still growing. Some events have photos and dates; others have only an announcement or a short description. We have left missing details open until we can confirm them.')}</p></section>
    <div class="timeline">{milestones.map(milestone => {const linkedEvents = newestEventsFirst(milestone.eventIds.map(publishedEvent).filter((event): event is EventRecord => Boolean(event)));return <article><time datetime={String(milestone.year)}>{formatNumber(locale,milestone.year)}</time><div><h2>{t(milestone.title)}</h2><p>{t(milestone.summary)}</p>{linkedEvents.length > 0 && <nav class="subnav" aria-label={t(`Event records for ${milestone.year}`)}>{linkedEvents.map(event => <a href={eventHref(event, locale)} lang={eventLocale(event, locale)}>{eventTitle(event)}{locale === 'fa' && eventLocale(event, locale) === 'en' && <span> ({t('English record')})</span>}</a>)}</nav>}{milestone.id === 'team-2026' && <a class="text-link" href={href(locale, 'about/leadership/2026-2027')}>{t('Meet the 2026-2027 team')}</a>}</div></article>;})}</div>
    <section class="notice"><h2>{t('Add a missing piece.')}</h2><p>{t('Recognize an event or have an old poster or photo? Send it to us with any details you remember, and tell us what we may publish.')}</p><div class="subnav"><a href={emailLink(t('SIGS history contribution'))}>{t('Contribute to the history')}</a><a href={href(locale, 'events/archive')}>{t('View all events')}</a></div></section>
  </>}

  {path === 'partners' && <>
    {organization.currentSponsors.length>0 && <section class="prose"><h2>{t('Current partners')}</h2><ul>{organization.currentSponsors.map(partner=><li>{partner.url?<a href={partner.url}>{partner.name}</a>:partner.name}</li>)}</ul></section>}
    <section class="partner-intro"><p class="eyebrow" style="color:var(--navy)">{t('Start a conversation')}</p><h2>{t('Plan an event with SIGS.')}</h2><p>{t('Want to host a cultural event, welcome new students, or arrange a conversation with the community? We would like to hear from campus groups, alumni, and local organizations.')}</p><a class="button navy" href={emailLink(t('SIGS partnership inquiry'))}>{t('Discuss a collaboration')} <span aria-hidden="true">↗</span></a></section>
    <div class="program-list"><section class="program"><h2>{t('A cultural gathering.')}</h2><p>{t('Help us put on a Nowruz or Yalda celebration. Get in touch about a venue, a performance, or other help with the event.')}</p><a class="text-link" href={contextLink('events/nowruz-2018')} hreflang={contextLanguage('events/nowruz-2018')}>{contextLabel('events/nowruz-2018', 'A Nowruz example from 2018')}{locale === 'fa' && contextLanguage('events/nowruz-2018') === 'en' && <span> ({t('English record')})</span>}</a></section><section class="program"><h2>{t('A professional conversation.')}</h2><p>{t('Past examples include the 2018 Iranian American Innovation Forum and the 2025 Rising Leaders networking invitation. If you have a speaker or topic in mind, send us your idea.')}</p><a class="text-link" href={contextLink('events/innovation-forum-2018')} hreflang={contextLanguage('events/innovation-forum-2018')}>{contextLabel('events/innovation-forum-2018', 'The Iranian American Innovation Forum')}{locale === 'fa' && contextLanguage('events/innovation-forum-2018') === 'en' && <span> ({t('English record')})</span>}</a></section><section class="program"><h2>{t('A welcome to campus.')}</h2><p>{t('Help new students find their feet at UCI. You could share what you know about campus or help arrange a welcome gathering.')}</p><a class="text-link" href={contextLink('events/welcome-2017')} hreflang={contextLanguage('events/welcome-2017')}>{contextLabel('events/welcome-2017', 'The 2017 welcome announcement')}{locale === 'fa' && contextLanguage('events/welcome-2017') === 'en' && <span> ({t('English record')})</span>}</a></section><section class="program"><h2>{t('Film, poetry, and discussion.')}</h2><p>{t('Our past programs include Docunight screenings and Persian Poetry Night. Suggest a film, a poetry session, or a discussion you would like to help organize.')}</p><a class="text-link" href={href(locale, 'community/programs/docunight')}>{t('Read about Docunight')}</a></section></div>
    <section class="prose" style="margin-top:56px"><h2>{t('Historical acknowledgments.')}</h2>{organization.historicalAcknowledgments.map(acknowledgment => <><p>{t('A presentation associated with Yalda 2019 thanks these organizations:')}</p><ul>{acknowledgment.names.map(name => <li>{t(name)}</li>)}</ul><p>{t('These names are part of the 2019 record. Contact the SIGS team about any new partnership.')}</p></>)}</section>
  </>}

  {path === 'join' && <div class="aside-layout">
    <div class="join-steps"><section class="join-step"><h2>{t('Say hello.')}</h2><p>{t('Tell us a little about yourself and ask about joining. You can email us before coming to your first event.')}</p><a href={emailLink(t('Connect with SIGS'))}>{t('Email SIGS')}</a></section><section class="join-step"><h2>{t('Come to a gathering.')}</h2><p>{t('Check the events page for the latest gathering, location, and registration details. Some activities have specific eligibility or signup requirements.')}</p><a href={href(locale, 'events')}>{t('See events and the archive')}</a></section><section class="join-step"><h2>{t('Help make something happen.')}</h2><p>{t('Have an activity in mind or some time to help? Email us about organizing, welcoming new students, or adding photos and details to the archive.')}</p><a href={emailLink(t('Help with SIGS activities'))}>{t('Offer an idea or a hand')}</a></section></div>
    <aside class="callout"><h2>{t('New to UCI?')}</h2><p>{t('Our newcomer guide links to campus services for your first weeks. You can also email SIGS with questions about student life.')}</p><a class="button navy" href={href(locale, 'resources/new-students')}>{t('Read the newcomer guide')}</a><p style="margin-top:20px">{t('To join, email SIGS. You can also find the team and their LinkedIn profiles on the leadership page.')}</p><a class="text-link" href={href(locale, 'about/leadership')}>{t('Meet the team')}</a></aside>
  </div>}

  {path === 'contact' && <>
    <section class="prose"><p>{t('Each link below opens an email to SIGS with a suggested subject. You can also write directly to')} <a href={`mailto:${site.email}`}><bdi>{site.email}</bdi></a>.</p></section>
    {organization.socialChannels.length > 0 && <nav class="subnav" aria-label={t('SIGS social accounts')}>{organization.socialChannels.map(channel => <a href={channel.url}>{t(channel.name)} <span aria-hidden="true">↗</span></a>)}</nav>}
    <div class="contact-routes">{contactRoutes.map(route => <section class="contact-route"><h2>{t(route.title)}</h2><p>{t(route.text)}</p><a class="text-link" href={emailLink(t(route.subject))}>{t(route.action)} <span aria-hidden="true">↗</span></a></section>)}</div>
    <p class="notice">{t('Email links open your email application. Please share only the personal information needed for your question. Public repository issues are visible to everyone.')}</p>
  </>}

  {path === 'privacy' && <article class="prose">
    <h2>{t('Reading and searching the site.')}</h2>
    <p>{t('This is a static website. Its site search runs in your browser with Pagefind and downloads the search files it needs from the website. Search terms are not sent to a separate search provider. A term included in a page URL may appear in browser history or hosting logs.')}</p>
    {analyticsEnabled ? <>
      <p>{t('Cloudflare Web Analytics measures page views and page performance on this website. SIGS uses aggregate reports about visited pages, referring websites, and device types.')}</p>
      <p><a href="https://developers.cloudflare.com/web-analytics/about/">{t('About Cloudflare Web Analytics')}</a></p>
      <p>{t('The site does not add advertising, signup forms, or tracking cookies. Fonts are served with the website. There is no SIGS account to create on this site.')}</p>
    </> : <p>{t('The site does not add analytics, advertising, signup forms, or tracking cookies. Fonts are served with the website. There is no SIGS account to create on this site.')}</p>}
    <h2>{t('Website hosting.')}</h2><p>{t('This website is hosted on GitHub Pages. GitHub records visitor IP addresses for security when a Pages site is visited. Requests may also include browser and connection information.')}</p><p><a href="https://docs.github.com/en/pages/getting-started-with-github-pages/what-is-github-pages#data-collection">{t('GitHub Pages data collection')}</a><br /><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{t('GitHub General Privacy Statement')}</a></p><h2>{t('Email and external links.')}</h2><p>{t('An email link opens your email application. Sending a message shares its contents and your email address with SIGS and the email services involved. Only include what is needed to answer your question.')}</p><p>{t('Campus resources, registration forms, LinkedIn profiles, and other external links have their own privacy practices. Public GitHub issues and repository contributions can be read by anyone.')}</p><h2>{t('Photographs and corrections.')}</h2><p>{t('This site includes photos and videos from SIGS activities. To ask about an image, request removal, or correct personal information on a page, email SIGS with the page link and enough detail to identify it.')}</p><a href={emailLink(t('SIGS privacy request'))}>{t('Contact SIGS about privacy')}</a>
  </article>}

  {path === 'accessibility' && <article class="prose"><h2>{t('Using the site.')}</h2><p>{t('We aim to make SIGS information usable with a keyboard, on small screens, and with assistive technology. The site uses headings and landmarks, visible keyboard focus, labeled controls, and a skip link to the main content.')}</p><p>{t('Event pages list the date, time, and venue in text when those details are known. Images have alternative text, and captions explain their context. Pages and ordinary links work without JavaScript; search and gallery controls need it.')}</p><h2>{t('Motion, language, and content limits.')}</h2><p>{t('The interface respects the reduced motion setting in your device or browser. The site is available in English and Persian, with a right-to-left Persian interface and locally served fonts. Historical records sometimes lack a time, venue detail, or photograph; those gaps are kept visible.')}</p><p>{t('External campus pages and documents have their own interfaces. If a linked PDF or another part of the site is difficult to use, tell us which information you need. This statement is an aim and a contact route, not an accessibility certification.')}</p><h2>{t('Tell us about a barrier.')}</h2><p>{t('Email the page URL, the action you were trying to take, and what prevented it. Your browser, device, and assistive technology can help explain the problem if you are comfortable sharing them. For an event access question, include the event title.')}</p><a class="button primary" href={emailLink(t('SIGS accessibility request'))}>{t('Ask for accessibility help')}</a></article>}

  {path === 'languages' && <div class="aside-layout"><article class="prose"><h2>{t('Read SIGS in English or Persian.')}</h2><p>{t('Choose a language in the header. The switch opens the same page in the other language when a translation is available.')}</p><h2>{t('Dates and event details.')}</h2><p>{t('Both versions use the same event dates, places, and team contacts. Dates are shown in the Gregorian calendar. Recorded times keep their campus or historical context.')}</p><h2>{t('Help us keep the wording accurate.')}</h2><p>{t('If a name, translation, or mixed Persian and English line needs correction, send the page link and your suggestion.')}</p><a class="button primary" href={emailLink(t('SIGS language correction'))}>{t('Suggest a language correction')}</a></article><aside class="callout"><h2>{t('Browse in either language.')}</h2><p>{t('Find the current team, browse past gatherings, or get in touch with SIGS.')}</p><div class="subnav"><a href={href('en')} lang="en" hreflang="en" dir="ltr">English</a><a href={href('fa')} lang="fa" hreflang="fa" dir="rtl">فارسی</a></div></aside></div>}
  {path === 'community' && communityStories.length > 0 && <section class="section" aria-labelledby="community-stories"><div class="section-heading"><h2 id="community-stories">{t('Stories and community documents')}</h2></div><div class="program-list">{communityStories.map(story => <article class="program"><p class="eyebrow">{t(story.kind === 'document' ? 'Historical document' : story.kind === 'yearbook' ? 'A year in SIGS' : 'Community story')}</p><h3><a href={href(story.locale, `community/stories/${story.slug}`)}>{story.title}</a></h3><p>{story.summary}</p><time datetime={story.publishedOn}>{formatDay(locale,story.publishedOn)}</time></article>)}</div></section>}
</div>

<style>
  .standard-page .community-feature{grid-template-columns:1fr 1.2fr;align-items:center;gap:40px;padding:0 0 36px;border-block-end:1px solid var(--line);border-radius:0;background:transparent;color:var(--ink)}
  .community-feature .eyebrow{color:var(--cobalt)}
  .community-feature h2{font-size:clamp(28px,2.8vw,38px);line-height:1.2;max-inline-size:14ch}
  .community-feature p:not(.eyebrow){font-size:17px;color:var(--muted);max-inline-size:55ch}
  .community-feature .button{border-radius:3px}
  .community-feature figure{margin:0;min-inline-size:0}
  .community-feature img{inline-size:100%;block-size:auto;aspect-ratio:4/3;object-fit:contain;border-radius:3px}
  .community-feature figcaption{font-size:14px;margin-block-start:12px}
  .community-feature figcaption a{color:var(--muted)}
  .standard-page .notice{border:0;border-inline-start:2px solid var(--gold);border-radius:0;padding:24px 28px;background:var(--canvas)}
  .standard-page .notice h2{font-size:25px;line-height:1.4}
  .standard-page .notice p{max-inline-size:70ch;font-size:16px}
  .standard-page .partner-intro{padding:32px 0;border-block:1px solid var(--line);border-radius:0;background:transparent}
  .standard-page .partner-intro h2{font-size:clamp(28px,2.8vw,38px);max-inline-size:22ch}
  .standard-page .partner-intro p:not(.eyebrow){max-inline-size:70ch;font-size:17px;color:var(--muted)}
  .standard-page .callout{padding:4px 0;padding-inline-start:28px;border:0;border-inline-start:1px solid var(--line);border-radius:0;background:transparent}
  .standard-page .callout h2{font-size:23px;line-height:1.4}
  .standard-page .contact-route h2{font-size:25px;line-height:1.4}
  :global(html[lang=fa]) .community-feature h2{line-height:1.5;letter-spacing:normal}
  .resource-guide-nav{border-block:1px solid var(--line);padding-block:20px;margin-block-end:36px;scroll-margin-block-start:28px}
  .resource-guide-nav h2{font-size:21px;margin-block:0 12px}
