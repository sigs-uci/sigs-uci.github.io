---
import { href, emailLink, site, type Locale } from '../config/site';
import { tr } from '../i18n/ui';
import { events, media, milestones, organization, programs, resources } from '../data';
import Gallery from './Gallery.astro';

const { locale = 'en', path } = Astro.props as { locale: Locale; path: string };
const t = (text: string) => tr(locale, text);
const resourceGroups = [
  { id: 'arriving', title: 'Before you arrive', summary: 'Start with the university offices that handle your arrival questions.' },
  { id: 'settling-in', title: 'A place to settle in', summary: 'Read current housing information before making plans.' },
  { id: 'campus', title: 'Around campus', summary: 'Find your building and plan how to get there.' },
  { id: 'support', title: 'Support when you need it', summary: 'Go directly to campus services for their current information and ways to ask for help.' },
  { id: 'connections', title: 'Your graduate community', summary: 'Find workshops, student representation, and people beyond your department.' },
];
const programLinks: Record<string, { path: string; text: string }> = {
  docunight: { path: 'community/programs/docunight', text: 'Read about Docunight' },
  'welcome-and-orientation': { path: 'resources/new-students', text: 'Start the newcomer guide' },
  'social-and-outdoors': { path: 'join', text: 'Get in touch' },
  'cultural-celebrations': { path: 'events/nowruz-2018', text: 'Return to Nowruz 2018' },
  'professional-connections': { path: 'events/innovation-forum-2018', text: 'Read about the 2018 forum' },
  'poetry-and-film': { path: 'events/poetry-night-2019', text: 'Return to Poetry Night' },
};
const contactRoutes = [
  { title: 'Join or say hello', text: 'New to UCI, curious about SIGS, or looking for the next gathering? Tell us what you would like to know.', subject: 'Connect with SIGS', action: 'Ask about taking part' },
  { title: 'Plan a collaboration', text: 'Share an idea for a cultural gathering, a newcomer welcome, or a professional conversation.', subject: 'SIGS collaboration inquiry', action: 'Discuss an idea' },
  { title: 'Correct the archive', text: 'Send the public page link and the detail that needs attention. Tell us if your supporting material should remain private.', subject: 'SIGS archive correction', action: 'Send a correction' },
  { title: 'Ask about a photograph', text: 'For a photo question or removal request, include the page and a description of the image. Please avoid sending information about other attendees.', subject: 'SIGS photo request', action: 'Contact us about an image' },
  { title: 'Report an access barrier', text: 'Describe the page or event and the help you need. For a website problem, your browser and device type can help us understand it.', subject: 'SIGS accessibility request', action: 'Ask for accessibility help' },
];
---

<div class="wrap page-body">
  {path === 'community' && <>
    <section class="feature-type" aria-labelledby="community-together">
      <div><p class="eyebrow" style="color:var(--gold)">{t('Life in SIGS')}</p><h2 id="community-together">{t('A reason to get together.')}</h2><p>{t('A celebration can fill a room. A poem or a film can start a conversation. SIGS has made space for both, along with the ordinary pleasure of meeting someone new.')}</p><a class="button light" href={href(locale, 'join')}>{t('Find your way in')}</a></div>
      <div class="persian-display" aria-hidden="true">SIGS</div>
    </section>
    <div class="program-list">{programs.map(program => <section class="program"><p class="eyebrow">{t(program.period)}</p><h2>{t(program.name)}</h2><p>{t(program.summary)}</p><a class="text-link" href={href(locale, programLinks[program.id].path)}>{t(programLinks[program.id].text)} <span aria-hidden="true">↗</span></a></section>)}</div>
    <section class="notice"><h2>{t('Bring a memory. Help with the next gathering.')}</h2><p>{t('Have a story to share, an idea for an activity, or time to help organize? Start with a conversation with the team.')}</p><div class="subnav"><a href={href(locale, 'community/memories')}>{t('Explore memories')}</a><a href={emailLink('Take part in SIGS')}>{t('Offer an idea or a hand')}</a></div></section>
  </>}

  {path === 'community/memories' && <>
    <Gallery items={media.filter(item => item.publication === 'published' && item.rights === 'approved')} locale={locale} />
    <div class="aside-layout">
      <section class="prose"><h2>{t('The record of a gathering.')}</h2><p>{t('A date, a title, and a place can bring an evening back. The archive keeps those details together, with a clear distinction between documented gatherings and announcements of what was planned.')}</p><p>{t('Photographs will appear here after they have been selected for public use and their captions and credits have been checked. For now, follow the stories through the event records.')}</p><a class="button primary" href={href(locale, 'events/archive')}>{t('Browse the event archive')}</a></section>
      <aside class="callout"><h2>{t('A photograph to contribute?')}</h2><p>{t('Tell us which gathering it shows, who took it if known, and any limits on sharing it. A private album link is best sent by email.')}</p><a class="button navy" href={emailLink('SIGS memory contribution')}>{t('Contact SIGS')}</a></aside>
    </div>
    <section class="section" aria-labelledby="memory-start"><div class="section-heading"><h2 id="memory-start">{t('Three evenings in the archive.')}</h2></div><div class="history-home">{['yalda-2015', 'nowruz-2018', 'poetry-night-2019'].map(id => { const event = events.find(record => record.id === id)!; return <a class="history-entry" href={href(locale, `events/${event.slug}`)}><time datetime={event.date.value ?? undefined}>{event.date.value?.slice(0, 4)}</time><h3>{t(event.title)}</h3><span class="quiet">{t(event.archiveLabel ?? 'Historical record')}</span><span class="entry-arrow" aria-hidden="true">↗</span></a>; })}</div></section>
    <section class="prose"><h2>{t('Whose memory is it?')}</h2><p>{t('A caption should keep the event context and the photographer’s credit. Please tell us if an image of you needs attention. We can discuss a correction or removal without a public issue.')}</p><a href={emailLink('SIGS photo correction or removal')}>{t('Ask about a photograph')}</a></section>
  </>}

  {path === 'community/programs/docunight' && <div class="aside-layout">
    <article class="prose"><p class="eyebrow">{t('A historical program · 2017-2018')}</p><h2>{t('Documentary film, shared conversation.')}</h2><p>{t(programs.find(program => program.id === 'docunight')!.summary)}</p><p>{t('The Jordan Center’s 2017-2018 annual report describes the co-presented program. Its record gives context for this part of SIGS history; individual screening dates and titles are not listed here.')}</p><h2>{t('Part of a wider film and poetry story.')}</h2><p>{t('The archive also includes a Tales screening and Q&A announcement from 2016, and a documented Persian Poetry Night in 2019. Each has its own event record.')}</p><div class="subnav"><a href={href(locale, 'events/tales-2016')}>{t('Tales, March 2016')}</a><a href={href(locale, 'events/poetry-night-2019')}>{t('Poetry Night, February 2019')}</a></div><p><a href="https://bpb-us-e2.wpmucdn.com/sites.uci.edu/dist/7/1776/files/2021/04/2017-2018-Annual-Report.pdf">{t('Read the Jordan Center annual report (PDF, printed page 6)')}</a></p></article>
    <aside class="callout"><h2>{t('Have more context?')}</h2><p>{t('If you remember a screening or have a public program to contribute, send us the details. We will keep uncertain dates visible until they can be checked.')}</p><a class="button navy" href={emailLink('Docunight archive contribution')}>{t('Share a correction or memory')}</a><a class="text-link" href={href(locale, 'community')}>{t('Back to Community')}</a></aside>
  </div>}

  {(path === 'resources' || path === 'resources/new-students') && <>
    {path === 'resources/new-students' && <section class="prose"><h2>{t('Start with the practical things.')}</h2><p>{t('There is a lot to work out in the first few weeks. Use the official links below for current requirements and services. Bring your everyday campus questions to SIGS when you would like a student connection.')}</p><p>{t('For immigration, health, housing eligibility, or financial requirements, ask the responsible university office. This guide points you to those offices and does not replace their advice.')}</p></section>}
    {path === 'resources' && <section class="prose"><p>{t('These links lead to official campus information. Start with the task you need to complete, then check the responsible office’s current guidance.')}</p><a class="text-link" href={href(locale, 'resources/new-students')}>{t('New here? Start with the newcomer guide')} <span aria-hidden="true">↗</span></a></section>}
    <div class="aside-layout" style="margin-top:40px">
      <div>{resourceGroups.map(group => <section class="resource-list" id={group.id} aria-labelledby={`${group.id}-heading`}><h2 id={`${group.id}-heading`}>{t(group.title)}</h2><p class="quiet">{t(group.summary)}</p>{resources.filter(resource => resource.category === group.id).map(resource => <article class="resource-item"><h3><a href={resource.url}>{t(resource.title)} <span aria-hidden="true">↗</span></a></h3><p>{t(resource.description)}</p><small>{t(resource.source)}<br />{t('Link and description checked')}: <time datetime={resource.reviewedOn}>{resource.reviewedOn}</time> · {t(resource.ownerRole)}</small></article>)}</section>)}</div>
      <aside><nav class="resource-nav callout" aria-label={t('In this guide')}><h2>{t('In this guide')}</h2>{resourceGroups.map(group => <a href={`#${group.id}`}>{t(group.title)}</a>)}<a href="#connect-with-sigs">{t('Connect with SIGS')}</a></nav></aside>
    </div>
    <section class="notice" id="connect-with-sigs"><h2>{t('A person to ask.')}</h2><p>{t('You can contact SIGS before attending a gathering. Tell us that you are new to campus and what you would like to know. Each activity may have its own audience and registration requirements.')}</p><a class="button primary" href={emailLink('New to UCI and SIGS')}>{t('Say hello to SIGS')}</a></section>
    <p class="archive-note">{t('This directory is maintained by the SIGS content steward. Review dates cover the linked page and its description, not approval of individual advice. Found a moved link?')} <a href={emailLink('SIGS resource correction')}>{t('Send a correction.')}</a></p>
  </>}

  {path === 'about' && <div class="aside-layout">
    <article class="prose"><h2>{t('The people make the community.')}</h2><p>{t(organization.description)}</p><p>{t('Across different generations of students, activities have included Nowruz and Yalda, film and poetry, informal gatherings, newcomer orientation, and conversations with campus and community partners.')}</p><h2>{t('A student organization at UC Irvine.')}</h2><p>{t('SIGS is registered at UC Irvine for 2026-2027, as confirmed by the organization on October 22, 2026. This website is maintained by SIGS.')}</p><p>{t('Graduate-student membership and participation in individual activities are distinct. Contact the team about taking part, and check each event’s published requirements.')}</p><h2>{t('Carried from one team to the next.')}</h2><p>{t('The current 2026-2027 team includes four Board roles, three Support Team members, and an Advisor. The previous 2025-2026 team has its own term page.')}</p><div class="subnav"><a href={href(locale, 'about/leadership')}>{t('Meet the current team')}</a><a href={href(locale, 'about/leadership/2025-2026')}>{t('The previous team')}</a><a href={href(locale, 'about/history')}>{t('Read our history')}</a></div></article>
    <aside class="callout"><h2>{t('Keep in touch.')}</h2><p>{t('Ask about SIGS, suggest a gathering, or tell us what you would like to help with.')}</p><a class="button navy" href={emailLink('Hello SIGS')}>{t('Email SIGS')}</a><p style="margin-top:16px"><bdi>{site.email}</bdi></p></aside>
  </div>}

  {path === 'about/history' && <>
    <section class="prose"><p>{t('This is a partial chronology. Some years have photographs and dated records; others have an announcement or a short description. The gaps stay visible, and each event keeps the context that is known.')}</p></section>
    <div class="timeline">{milestones.map(milestone => <article><time datetime={String(milestone.year)}>{milestone.year}</time><div><h2>{t(milestone.title)}</h2><p>{t(milestone.summary)}</p>{milestone.eventIds.length > 0 && <nav class="subnav" aria-label={t(`Event records for ${milestone.year}`)}>{milestone.eventIds.map(id => { const event = events.find(record => record.id === id)!; return <a href={href(locale, `events/${event.slug}`)}>{t(event.title)}</a>; })}</nav>}{milestone.id === 'team-2026' && <a class="text-link" href={href(locale, 'about/leadership')}>{t('Meet the current team')}</a>}</div></article>)}</div>
    <section class="notice"><h2>{t('Add a missing piece.')}</h2><p>{t('A public poster, a date correction, or a caption can help preserve the story. Send us what you know and tell us what may be shared publicly.')}</p><div class="subnav"><a href={emailLink('SIGS history contribution')}>{t('Contribute to the history')}</a><a href={href(locale, 'events/archive')}>{t('Browse all event records')}</a></div></section>
  </>}

  {path === 'partners' && <>
    {organization.currentSponsors.length>0 && <section class="prose"><h2>{t('Current partners')}</h2><ul>{organization.currentSponsors.map(partner=><li>{partner.url?<a href={partner.url}>{partner.name}</a>:partner.name}</li>)}</ul></section>}
    <section class="partner-intro"><p class="eyebrow" style="color:var(--navy)">{t('Start a conversation')}</p><h2>{t('Help create the next gathering.')}</h2><p>{t('We welcome ideas from campus partners, alumni, and community organizations interested in cultural programs, student connection, or newcomer support.')}</p><a class="button navy" href={emailLink('SIGS partnership inquiry')}>{t('Discuss a collaboration')} <span aria-hidden="true">↗</span></a></section>
    <div class="program-list"><section class="program"><h2>{t('A cultural gathering.')}</h2><p>{t('Nowruz and Yalda are part of the SIGS archive. We would like to hear ideas for supporting a gathering, contributing a skill, or helping with the practical work of an event.')}</p><a class="text-link" href={href(locale, 'events/nowruz-2018')}>{t('A Nowruz example from 2018')}</a></section><section class="program"><h2>{t('A professional conversation.')}</h2><p>{t('The 2018 Iranian American Innovation Forum and the 2025 Rising Leaders networking announcement show two past collaboration formats. Ask about a conversation that fits the community today.')}</p><a class="text-link" href={href(locale, 'events/innovation-forum-2018')}>{t('The Iranian American Innovation Forum')}</a></section><section class="program"><h2>{t('A welcome to campus.')}</h2><p>{t('Newcomer gatherings have a place in SIGS history. An offer of time, local knowledge, or help arranging a welcome can begin with an email.')}</p><a class="text-link" href={href(locale, 'events/welcome-2017')}>{t('The 2017 welcome announcement')}</a></section><section class="program"><h2>{t('Film, poetry, and discussion.')}</h2><p>{t('Smaller cultural programs have included Docunight and Persian Poetry Night. Share an idea for a format, topic, or conversation.')}</p><a class="text-link" href={href(locale, 'community/programs/docunight')}>{t('Read about Docunight')}</a></section></div>
    <section class="prose" style="margin-top:56px"><h2>{t('Historical acknowledgments.')}</h2>{organization.historicalAcknowledgments.map(acknowledgment => <><p>{t('A 2019 Yalda-associated presentation acknowledges the following organizations:')}</p><ul>{acknowledgment.names.map(name => <li>{t(name)}</li>)}</ul><p>{t('These acknowledgments belong to that historical context. Any new collaboration and its public recognition will be agreed with the SIGS team.')}</p></>)}</section>
  </>}

  {path === 'join' && <div class="aside-layout">
    <div class="join-steps"><section class="join-step"><h2>{t('Say hello.')}</h2><p>{t('Email the team to introduce yourself or ask about taking part. You do not need to wait for a gathering to make contact.')}</p><a href={emailLink('Connect with SIGS')}>{t('Email SIGS')}</a></section><section class="join-step"><h2>{t('Come to a gathering.')}</h2><p>{t('The next event will appear when its details are confirmed. Check its audience, arrival information, and registration requirements before coming.')}</p><a href={href(locale, 'events')}>{t('See events and the archive')}</a></section><section class="join-step"><h2>{t('Help make something happen.')}</h2><p>{t('Suggest an activity or tell us how you would like to help with planning, welcoming people, or preserving the archive. The team can discuss the next useful step with you.')}</p><a href={emailLink('Help with SIGS activities')}>{t('Offer an idea or a hand')}</a></section></div>
    <aside class="callout"><h2>{t('New to UCI?')}</h2><p>{t('Start with official campus resources for your first weeks. For a student connection, send SIGS a note.')}</p><a class="button navy" href={href(locale, 'resources/new-students')}>{t('Read the newcomer guide')}</a><p style="margin-top:20px">{t('The organization email is the current joining route. Individual team contacts are listed on the leadership pages.')}</p><a class="text-link" href={href(locale, 'about/leadership')}>{t('Meet the team')}</a></aside>
  </div>}

  {path === 'contact' && <>
    <section class="prose"><p>{t('All of these routes reach the SIGS organization mailbox. Choose a subject below, or write directly to')} <a href={`mailto:${site.email}`}><bdi>{site.email}</bdi></a>.</p></section>
    <div class="contact-routes">{contactRoutes.map(route => <section class="contact-route"><h2>{t(route.title)}</h2><p>{t(route.text)}</p><a class="text-link" href={emailLink(route.subject)}>{t(route.action)} <span aria-hidden="true">↗</span></a></section>)}</div>
    <p class="notice">{t('Email links open your email application. Please share only the personal information needed for your question. Public repository issues are visible to everyone.')}</p>
  </>}

  {path === 'privacy' && <article class="prose"><h2>{t('Reading and searching the site.')}</h2><p>{t('This is a static website. Its site search runs in your browser with Pagefind and downloads the search files it needs from the website. Search terms are not sent to a separate search provider. A term included in a page URL may appear in browser history or hosting logs.')}</p><p>{t('The site does not add analytics, advertising, signup forms, or tracking cookies. Fonts are served with the website. There is no SIGS account to create on this site.')}</p><h2>{t('Website hosting.')}</h2><p>{t('The production website is designed for GitHub Pages. GitHub records visitor IP addresses for security when a Pages site is visited. Hosting requests may also include normal browser and request information.')}</p><p><a href="https://docs.github.com/en/pages/getting-started-with-github-pages/what-is-github-pages#data-collection">{t('GitHub Pages data collection')}</a><br /><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{t('GitHub General Privacy Statement')}</a></p><h2>{t('Email and external links.')}</h2><p>{t('An email link opens your email application. Sending a message shares its contents and your email address with SIGS and the email services involved. Only include what is needed to answer your question.')}</p><p>{t('Campus resources, Telegram profiles, and other external links open services with their own privacy practices. Follow a link only when you want to visit that service. Public GitHub issues and repository contributions are public.')}</p><h2>{t('Photographs and corrections.')}</h2><p>{t('Images are added to the public site after selection and a publication decision. You can contact SIGS about a photograph, a correction, or personal information appearing on a page. Include the public page link and enough detail to identify your concern.')}</p><a href={emailLink('SIGS privacy request')}>{t('Contact SIGS about privacy')}</a></article>}

  {path === 'accessibility' && <article class="prose"><h2>{t('A website people can use.')}</h2><p>{t('We aim to make SIGS information usable with a keyboard, on small screens, and with assistive technology. The site uses headings and landmarks, visible keyboard focus, labeled controls, and a skip link to the main content.')}</p><p>{t('Event records put available logistics in text. Images need alternative text and captions where their context matters. Reading pages and following ordinary links work without JavaScript; interactive search and gallery controls use JavaScript.')}</p><h2>{t('Motion, language, and content limits.')}</h2><p>{t('The interface respects the reduced motion setting in your device or browser. English is currently the published language while Persian text is prepared for review. Historical records sometimes lack a time, venue detail, or photograph; those gaps are kept visible.')}</p><p>{t('External campus pages and documents have their own interfaces. If a linked PDF or another part of the site is difficult to use, tell us which information you need. This statement is an aim and a contact route, not an accessibility certification.')}</p><h2>{t('Tell us about a barrier.')}</h2><p>{t('Email the page URL, the action you were trying to take, and what prevented it. Your browser, device, and assistive technology can help explain the problem if you are comfortable sharing them. For an event access question, include the event title.')}</p><a class="button primary" href={emailLink('SIGS accessibility request')}>{t('Ask for accessibility help')}</a></article>}

  {path === 'languages' && <div class="aside-layout"><article class="prose"><h2>{t('English is available now.')}</h2><p>{t('The current website is published in English. Persian pages are being prepared and need editorial review before publication. You can use all published event records and contact routes in English while that work continues.')}</p><h2>{t('Shared facts across languages.')}</h2><p>{t('Dates, places, and team contacts belong to shared records. A reviewed translation will keep those facts in step with the English page. Pages without a Persian counterpart will keep a clear route to the English record.')}</p><h2>{t('Help with Persian review.')}</h2><p>{t('A fluent reviewer can help check natural phrasing, names, and mixed Persian and English text. Contact the team if you would like to help. A page will only be presented as a published Persian translation after its review.')}</p><a class="button primary" href={emailLink('Help review Persian SIGS pages')}>{t('Offer to review Persian text')}</a></article><aside class="callout"><h2>{t('Keep exploring.')}</h2><p>{t('Find the current team, browse past gatherings, or get in touch with SIGS.')}</p><div class="subnav"><a href={href('en', 'events')}>{t('Events in English')}</a><a href={href('en', 'about/leadership')}>{t('Meet the team')}</a><a href={href('en', 'contact')}>{t('Contact SIGS')}</a></div></aside></div>}
</div>
