---
import { href, emailLink, site, type Locale } from '../config/site';
import { tr, formatNumber, formatTerm, formatDay } from '../i18n/ui';
import { boardTerms, events, milestones, organization, programs, resources, stories, type EventRecord } from '../data';
import CollectionDirectory from './CollectionDirectory.astro';
import {mediaCollections,publicMedia} from '../lib/media';
import { isPublicEvent } from '../lib/events';
import { eventHref, eventLocale, isPublicStory, reviewedTranslation } from '../lib/publication';
import '../styles/editorial.css';

const { locale = 'en', path } = Astro.props as { locale: Locale; path: string };
const t = (text: string) => tr(locale, text);
const publishedEvent = (id: string) => events.find(event => event.id === id && isPublicEvent(event));
const eventTitle = (event: EventRecord) => eventLocale(event, locale) === 'fa' ? reviewedTranslation(event.id)?.title ?? event.title : event.title;
const contextEvent = (path: string) => events.find(event => path === `events/${event.slug}` && isPublicEvent(event));
const contextLink = (path: string) => {
  if (!path.startsWith('events/')) return href(locale, path);
  const event = contextEvent(path);
  return event ? eventHref(event, locale) : href(locale, 'events/archive');
};
const contextLanguage = (path: string) => { const event = contextEvent(path); return event ? eventLocale(event, locale) : locale; };
const contextLabel = (path: string, label: string) => t(path.startsWith('events/') && !contextEvent(path) ? 'Browse the event archive' : label);
const communityStories = stories.filter(story => story.locale === locale && isPublicStory(story));
const currentTeam = boardTerms.find(term => term.id === organization.currentBoardTermId);
const previousTeam = boardTerms.filter(term => term.status === 'former').sort((a, b) => b.id.localeCompare(a.id))[0];
const communityPhoto = publicMedia.find(item => item.id === 'boat-outing-image-071');
const resourceGroups = [
  { id: 'arriving', title: 'Before you arrive', summary: 'Start with the university offices that handle your arrival questions.' },
  { id: 'settling-in', title: 'A place to settle in', summary: 'Read current housing information before making plans.' },
  { id: 'campus', title: 'Around campus', summary: 'Find your building and plan how to get there.' },
  { id: 'support', title: 'Support when you need it', summary: 'Go directly to campus services for their current information and ways to ask for help.' },
  { id: 'connections', title: 'Your graduate community', summary: 'Find workshops, student representation, and people beyond your department.' },
];
const contactRoutes = [
  { title: 'Join or say hello', text: 'New to UCI, curious about SIGS, or looking for the next gathering? Tell us what you would like to know.', subject: 'Connect with SIGS', action: 'Ask about taking part' },
  { title: 'Plan a collaboration', text: 'Share an idea for a cultural gathering, a newcomer welcome, or a professional conversation.', subject: 'SIGS collaboration inquiry', action: 'Discuss an idea' },
  { title: 'Correct the archive', text: 'Send the public page link and the detail that needs attention. Tell us if your supporting material should remain private.', subject: 'SIGS archive correction', action: 'Send a correction' },
  { title: 'Ask about a photograph', text: 'For a photo question or removal request, include the page and a description of the image. Please avoid sending information about other attendees.', subject: 'SIGS photo request', action: 'Contact us about an image' },
  { title: 'Report an access barrier', text: 'Describe the page or event and the help you need. For a website problem, your browser and device type can help us understand it.', subject: 'SIGS accessibility request', action: 'Ask for accessibility help' },
];
---

<div class="wrap page-body">
  {path === 'community' && <>
    <section class="feature-type community-feature" aria-labelledby="community-together">
      <div><p class="eyebrow" style="color:var(--gold)">{t('Life in SIGS')}</p><h2 id="community-together">{t('A reason to get together.')}</h2><p>{t(organization.description)}</p><a class="button light" href={href(locale, 'join')}>{t('Find your way in')}</a></div>
      {communityPhoto?<figure><a href={href(locale,'community/memories/boat-outing')}><img src={communityPhoto.src} width={communityPhoto.width} height={communityPhoto.height} alt={communityPhoto.alt[locale]} /></a><figcaption><a href={href(locale,'community/memories/boat-outing')}>{t('Out on the water')} <span aria-hidden="true">↗</span></a></figcaption></figure>:<div class="persian-display" aria-hidden="true">SIGS</div>}
    </section>
    <section class="section" aria-labelledby="community-images"><div class="section-heading"><div><p class="eyebrow">{t('Photo collections')}</p><h2 id="community-images">{t('From the community archive.')}</h2></div><a class="text-link" href={href(locale,'community/memories')}>{t('Explore every collection')} ↗</a></div><CollectionDirectory locale={locale} collections={mediaCollections.slice(0,6)}/><a class="button primary" href={href(locale,'community/videos')}>{t('Watch all videos')} ↗</a></section>
    <div class="program-list">{programs.map(program => <section class="program"><p class="eyebrow">{t(program.period)}</p><h2><a href={href(locale, `community/programs/${program.id}`)}>{t(program.name)}</a></h2><p>{t(program.summary)}</p><a class="text-link" href={href(locale, `community/programs/${program.id}`)}>{t('Read the program story')} <span aria-hidden="true">↗</span></a></section>)}</div>
    <section class="notice"><h2>{t('Bring a memory. Help with the next gathering.')}</h2><p>{t('Have a story to share, an idea for an activity, or time to help organize? Start with a conversation with the team.')}</p><div class="subnav"><a href={href(locale, 'community/memories')}>{t('Explore memories')}</a><a href={emailLink(t('Take part in SIGS'))}>{t('Offer an idea or a hand')}</a></div></section>
  </>}

  {(path === 'resources' || path === 'resources/new-students') && <>
    <nav class="resource-guide-nav" aria-labelledby="resource-guide-heading"><h2 id="resource-guide-heading">{t('In this guide')}</h2><div>{resourceGroups.map(group=><a href={`#${group.id}`}>{t(group.title)} <span aria-hidden="true">↓</span></a>)}<a href="#connect-with-sigs">{t('Connect with SIGS')} <span aria-hidden="true">↓</span></a></div></nav>
    {path === 'resources/new-students' && <section class="prose"><h2>{t('Start with the practical things.')}</h2><p>{t('There is a lot to work out in the first few weeks. Use the official links below for current requirements and services. Bring your everyday campus questions to SIGS when you would like a student connection.')}</p><p>{t('For immigration, health, housing eligibility, or financial requirements, ask the responsible university office. This guide points you to those offices and does not replace their advice.')}</p></section>}
    {path === 'resources' && <section class="prose"><p>{t('These links lead to official campus information. Start with the task you need to complete, then check the responsible office’s current guidance.')}</p><p class="quiet">{formatNumber(locale,resources.length)} {t('official campus resources, grouped by what you need to do.')}</p><a class="text-link" href={href(locale, 'resources/new-students')}>{t('New here? Start with the newcomer guide')} <span aria-hidden="true">↗</span></a></section>}
    {path === 'resources/new-students' && <div class="newcomer-route"><section><p class="eyebrow">{t('Before arrival')}</p><h2>{t('Start with the university.')}</h2><p>{t('Find the official arrival checklists and the office responsible for your questions. Explore housing before planning your move.')}</p><ul><li><a href="#arriving">{t('Arrival and the International Center')}</a></li><li><a href="#housing">{t('Graduate and family housing')}</a></li></ul></section><section><p class="eyebrow">{t('Your first weeks')}</p><h2>{t('Get oriented on campus.')}</h2><p>{t('Find your building, look up transport, and get your campus technology working. Read the current new-student health information.')}</p><ul><li><a href="#campus">{t('Maps, transport, and campus services')}</a></li><li><a href="#student-health">{t('New-student health information')}</a></li><li><a href="#graduate-technology">{t('Campus technology')}</a></li></ul></section><section><p class="eyebrow">{t('As you settle in')}</p><h2>{t('Find people and support.')}</h2><p>{t('Make room for your life outside the department. Explore graduate writing and career support, campus activities, and SIGS.')}</p><ul><li><a href="#connections">{t('Graduate workshops and connections')}</a></li><li><a href="#support">{t('Campus support services')}</a></li><li><a href="#connect-with-sigs">{t('Say hello to SIGS')}</a></li></ul></section></div>}
    <div class="resource-guide-content">{resourceGroups.map(group => <section class="resource-list" id={group.id} aria-labelledby={`${group.id}-heading`}><h2 id={`${group.id}-heading`}>{t(group.title)}</h2><p class="quiet">{t(group.summary)}</p>{resources.filter(resource => resource.category === group.id).map(resource => <article class="resource-item" id={resource.id}><h3><a href={resource.url}>{t(resource.title)} <span aria-hidden="true">↗</span></a></h3><p>{t(resource.description)}</p><small>{t(resource.source)}<br />{t('Link and description checked')}: <time datetime={resource.reviewedOn}>{formatDay(locale,resource.reviewedOn)}</time> · {t(resource.ownerRole)}</small></article>)}<a class="resource-guide-back" href="#resource-guide-heading">{t('Back to guide topics')} <span aria-hidden="true">↑</span></a></section>)}</div>
    <section class="notice" id="connect-with-sigs"><h2>{t('A person to ask.')}</h2><p>{t('You can contact SIGS before attending a gathering. Tell us that you are new to campus and what you would like to know. Each activity may have its own audience and registration requirements.')}</p><a class="button primary" href={emailLink(t('New to UCI and SIGS'))}>{t('Say hello to SIGS')}</a></section>
    <p class="archive-note">{t('This directory is maintained by the SIGS content steward. Review dates cover the linked page and its description, not approval of individual advice. Found a moved link?')} <a href={emailLink(t('SIGS resource correction'))}>{t('Send a correction.')}</a></p>
  </>}

  {path === 'about' && <div class="aside-layout">
    <article class="prose"><h2>{t('The people make the community.')}</h2><p>{t(organization.description)}</p><p>{t('Across different generations of students, activities have included Nowruz and Yalda, film and poetry, informal gatherings, newcomer orientation, and conversations with campus and community partners.')}</p><h2>{t('A student organization at UC Irvine.')}</h2><p>{t('SIGS is registered at UC Irvine for 2026-2027, as confirmed by the organization on October 22, 2026. This website is maintained by SIGS.')}</p><p>{t('Graduate-student membership and participation in individual activities are distinct. Contact the team about taking part, and check each event’s published requirements.')}</p><h2>{t('Carried from one team to the next.')}</h2><p>{t('Meet the current team and explore the people who served in earlier terms.')}</p><p class="quiet">{t('Current term')}: <bdi dir="ltr">{formatTerm(locale,currentTeam?.term ?? organization.currentBoardTermId)}</bdi></p><div class="subnav"><a href={href(locale, 'about/leadership')}>{t('Meet the current team')}</a>{previousTeam && <a href={href(locale, `about/leadership/${previousTeam.id}`)}>{t('The previous team')}</a>}<a href={href(locale, 'about/history')}>{t('Read our history')}</a></div></article>
    <aside class="callout"><h2>{t('Keep in touch.')}</h2><p>{t('Ask about SIGS, suggest a gathering, or tell us what you would like to help with.')}</p><a class="button navy" href={emailLink(t('Hello SIGS'))}>{t('Email SIGS')}</a><p style="margin-top:16px"><bdi>{site.email}</bdi></p></aside>
  </div>}

  {path === 'about/history' && <>
    <section class="prose"><p>{t('This is a partial chronology. Some years have photographs and dated records; others have an announcement or a short description. The gaps stay visible, and each event keeps the context that is known.')}</p></section>
    <div class="timeline">{milestones.map(milestone => {const linkedEvents = milestone.eventIds.map(publishedEvent).filter((event): event is EventRecord => Boolean(event));return <article><time datetime={String(milestone.year)}>{formatNumber(locale,milestone.year)}</time><div><h2>{t(milestone.title)}</h2><p>{t(milestone.summary)}</p>{linkedEvents.length > 0 && <nav class="subnav" aria-label={t(`Event records for ${milestone.year}`)}>{linkedEvents.map(event => <a href={eventHref(event, locale)} lang={eventLocale(event, locale)}>{eventTitle(event)}{locale === 'fa' && eventLocale(event, locale) === 'en' && <span> ({t('English record')})</span>}</a>)}</nav>}{milestone.id === 'team-2026' && <a class="text-link" href={href(locale, 'about/leadership/2026-2027')}>{t('Meet the 2026-2027 team')}</a>}</div></article>;})}</div>
    <section class="notice"><h2>{t('Add a missing piece.')}</h2><p>{t('A public poster, a date correction, or a caption can help preserve the story. Send us what you know and tell us what may be shared publicly.')}</p><div class="subnav"><a href={emailLink(t('SIGS history contribution'))}>{t('Contribute to the history')}</a><a href={href(locale, 'events/archive')}>{t('Browse all event records')}</a></div></section>
  </>}

  {path === 'partners' && <>
    {organization.currentSponsors.length>0 && <section class="prose"><h2>{t('Current partners')}</h2><ul>{organization.currentSponsors.map(partner=><li>{partner.url?<a href={partner.url}>{partner.name}</a>:partner.name}</li>)}</ul></section>}
    <section class="partner-intro"><p class="eyebrow" style="color:var(--navy)">{t('Start a conversation')}</p><h2>{t('Help create the next gathering.')}</h2><p>{t('We welcome ideas from campus partners, alumni, and community organizations interested in cultural programs, student connection, or newcomer support.')}</p><a class="button navy" href={emailLink(t('SIGS partnership inquiry'))}>{t('Discuss a collaboration')} <span aria-hidden="true">↗</span></a></section>
    <div class="program-list"><section class="program"><h2>{t('A cultural gathering.')}</h2><p>{t('Nowruz and Yalda are part of the SIGS archive. We would like to hear ideas for supporting a gathering, contributing a skill, or helping with the practical work of an event.')}</p><a class="text-link" href={contextLink('events/nowruz-2018')} hreflang={contextLanguage('events/nowruz-2018')}>{contextLabel('events/nowruz-2018', 'A Nowruz example from 2018')}{locale === 'fa' && contextLanguage('events/nowruz-2018') === 'en' && <span> ({t('English record')})</span>}</a></section><section class="program"><h2>{t('A professional conversation.')}</h2><p>{t('The 2018 Iranian American Innovation Forum and the 2025 Rising Leaders networking announcement show two past collaboration formats. Ask about a conversation that fits the community today.')}</p><a class="text-link" href={contextLink('events/innovation-forum-2018')} hreflang={contextLanguage('events/innovation-forum-2018')}>{contextLabel('events/innovation-forum-2018', 'The Iranian American Innovation Forum')}{locale === 'fa' && contextLanguage('events/innovation-forum-2018') === 'en' && <span> ({t('English record')})</span>}</a></section><section class="program"><h2>{t('A welcome to campus.')}</h2><p>{t('Newcomer gatherings have a place in SIGS history. An offer of time, local knowledge, or help arranging a welcome can begin with an email.')}</p><a class="text-link" href={contextLink('events/welcome-2017')} hreflang={contextLanguage('events/welcome-2017')}>{contextLabel('events/welcome-2017', 'The 2017 welcome announcement')}{locale === 'fa' && contextLanguage('events/welcome-2017') === 'en' && <span> ({t('English record')})</span>}</a></section><section class="program"><h2>{t('Film, poetry, and discussion.')}</h2><p>{t('Smaller cultural programs have included Docunight and Persian Poetry Night. Share an idea for a format, topic, or conversation.')}</p><a class="text-link" href={href(locale, 'community/programs/docunight')}>{t('Read about Docunight')}</a></section></div>
    <section class="prose" style="margin-top:56px"><h2>{t('Historical acknowledgments.')}</h2>{organization.historicalAcknowledgments.map(acknowledgment => <><p>{t('A 2019 Yalda-associated presentation acknowledges the following organizations:')}</p><ul>{acknowledgment.names.map(name => <li>{t(name)}</li>)}</ul><p>{t('These acknowledgments belong to that historical context. Any new collaboration and its public recognition will be agreed with the SIGS team.')}</p></>)}</section>
  </>}

  {path === 'join' && <div class="aside-layout">
    <div class="join-steps"><section class="join-step"><h2>{t('Say hello.')}</h2><p>{t('Email the team to introduce yourself or ask about taking part. You do not need to wait for a gathering to make contact.')}</p><a href={emailLink(t('Connect with SIGS'))}>{t('Email SIGS')}</a></section><section class="join-step"><h2>{t('Come to a gathering.')}</h2><p>{t('The next event will appear when its details are confirmed. Check its audience, arrival information, and registration requirements before coming.')}</p><a href={href(locale, 'events')}>{t('See events and the archive')}</a></section><section class="join-step"><h2>{t('Help make something happen.')}</h2><p>{t('Suggest an activity or tell us how you would like to help with planning, welcoming people, or preserving the archive. The team can discuss the next useful step with you.')}</p><a href={emailLink(t('Help with SIGS activities'))}>{t('Offer an idea or a hand')}</a></section></div>
    <aside class="callout"><h2>{t('New to UCI?')}</h2><p>{t('Start with official campus resources for your first weeks. For a student connection, send SIGS a note.')}</p><a class="button navy" href={href(locale, 'resources/new-students')}>{t('Read the newcomer guide')}</a><p style="margin-top:20px">{t('The organization email is the current joining route. Individual team contacts are listed on the leadership pages.')}</p><a class="text-link" href={href(locale, 'about/leadership')}>{t('Meet the team')}</a></aside>
  </div>}

  {path === 'contact' && <>
    <section class="prose"><p>{t('All of these routes reach the SIGS organization mailbox. Choose a subject below, or write directly to')} <a href={`mailto:${site.email}`}><bdi>{site.email}</bdi></a>.</p></section>
    <div class="contact-routes">{contactRoutes.map(route => <section class="contact-route"><h2>{t(route.title)}</h2><p>{t(route.text)}</p><a class="text-link" href={emailLink(t(route.subject))}>{t(route.action)} <span aria-hidden="true">↗</span></a></section>)}</div>
    <p class="notice">{t('Email links open your email application. Please share only the personal information needed for your question. Public repository issues are visible to everyone.')}</p>
  </>}

  {path === 'privacy' && <article class="prose"><h2>{t('Reading and searching the site.')}</h2><p>{t('This is a static website. Its site search runs in your browser with Pagefind and downloads the search files it needs from the website. Search terms are not sent to a separate search provider. A term included in a page URL may appear in browser history or hosting logs.')}</p><p>{t('The site does not add analytics, advertising, signup forms, or tracking cookies. Fonts are served with the website. There is no SIGS account to create on this site.')}</p><h2>{t('Website hosting.')}</h2><p>{t('The production website is designed for GitHub Pages. GitHub records visitor IP addresses for security when a Pages site is visited. Hosting requests may also include normal browser and request information.')}</p><p><a href="https://docs.github.com/en/pages/getting-started-with-github-pages/what-is-github-pages#data-collection">{t('GitHub Pages data collection')}</a><br /><a href="https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement">{t('GitHub General Privacy Statement')}</a></p><h2>{t('Email and external links.')}</h2><p>{t('An email link opens your email application. Sending a message shares its contents and your email address with SIGS and the email services involved. Only include what is needed to answer your question.')}</p><p>{t('Campus resources, Telegram profiles, and other external links open services with their own privacy practices. Follow a link only when you want to visit that service. Public GitHub issues and repository contributions are public.')}</p><h2>{t('Photographs and corrections.')}</h2><p>{t('Images are added to the public site after selection and a publication decision. You can contact SIGS about a photograph, a correction, or personal information appearing on a page. Include the public page link and enough detail to identify your concern.')}</p><a href={emailLink(t('SIGS privacy request'))}>{t('Contact SIGS about privacy')}</a></article>}

  {path === 'accessibility' && <article class="prose"><h2>{t('A website people can use.')}</h2><p>{t('We aim to make SIGS information usable with a keyboard, on small screens, and with assistive technology. The site uses headings and landmarks, visible keyboard focus, labeled controls, and a skip link to the main content.')}</p><p>{t('Event records put available logistics in text. Images need alternative text and captions where their context matters. Reading pages and following ordinary links work without JavaScript; interactive search and gallery controls use JavaScript.')}</p><h2>{t('Motion, language, and content limits.')}</h2><p>{t('The interface respects the reduced motion setting in your device or browser. The site is available in English and Persian, with a right-to-left Persian interface and locally served fonts. Historical records sometimes lack a time, venue detail, or photograph; those gaps are kept visible.')}</p><p>{t('External campus pages and documents have their own interfaces. If a linked PDF or another part of the site is difficult to use, tell us which information you need. This statement is an aim and a contact route, not an accessibility certification.')}</p><h2>{t('Tell us about a barrier.')}</h2><p>{t('Email the page URL, the action you were trying to take, and what prevented it. Your browser, device, and assistive technology can help explain the problem if you are comfortable sharing them. For an event access question, include the event title.')}</p><a class="button primary" href={emailLink(t('SIGS accessibility request'))}>{t('Ask for accessibility help')}</a></article>}

  {path === 'languages' && <div class="aside-layout"><article class="prose"><h2>{t('Read SIGS in English or Persian.')}</h2><p>{t('Choose a language in the header. The switch opens the same page in the other language when a translation is available.')}</p><h2>{t('Shared facts, clear dates.')}</h2><p>{t('Both versions use the same event dates, places, and team contacts. Dates are shown in the Gregorian calendar. Recorded times keep their campus or historical context.')}</p><h2>{t('Help us keep the wording accurate.')}</h2><p>{t('If a name, translation, or mixed Persian and English line needs correction, send the page link and your suggestion.')}</p><a class="button primary" href={emailLink(t('SIGS language correction'))}>{t('Suggest a language correction')}</a></article><aside class="callout"><h2>{t('Browse in either language.')}</h2><p>{t('Find the current team, browse past gatherings, or get in touch with SIGS.')}</p><div class="subnav"><a href={href('en')} lang="en" hreflang="en" dir="ltr">English</a><a href={href('fa')} lang="fa" hreflang="fa" dir="rtl">فارسی</a></div></aside></div>}
  {path === 'community' && communityStories.length > 0 && <section class="section" aria-labelledby="community-stories"><div class="section-heading"><h2 id="community-stories">{t('Stories and annual highlights')}</h2></div><div class="program-list">{communityStories.map(story => <article class="program"><p class="eyebrow">{t(story.kind === 'yearbook' ? 'A year in SIGS' : 'Community story')}</p><h3><a href={href(story.locale, `community/stories/${story.slug}`)}>{story.title}</a></h3><p>{story.summary}</p><time datetime={story.publishedOn}>{formatDay(locale,story.publishedOn)}</time></article>)}</div></section>}
</div>

<style>
  .community-feature{grid-template-columns:1fr 1.2fr;align-items:center;gap:40px;padding:40px}
  .community-feature figure{margin:0;min-inline-size:0}
  .community-feature img{inline-size:100%;block-size:auto;aspect-ratio:4/3;object-fit:contain;border-radius:4px}
  .community-feature figcaption{font-size:14px;margin-block-start:12px}
  .community-feature figcaption a{color:white}
  .resource-guide-nav{border-block:1px solid var(--line);padding-block:20px;margin-block-end:36px;scroll-margin-block-start:28px}
  .resource-guide-nav h2{font-size:21px;margin-block:0 12px}
  .resource-guide-nav>div{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:4px 28px}
  .resource-guide-nav a{display:flex;align-items:center;justify-content:space-between;gap:12px;min-block-size:48px;border-block-end:1px solid var(--line);color:var(--cobalt);font-size:15px;text-decoration:none}
  .resource-guide-nav a:hover{text-decoration:underline}
  .resource-guide-nav a span{flex-shrink:0}
  .resource-guide-content{margin-block-start:40px;max-inline-size:900px}
  .resource-guide-content .resource-list{scroll-margin-block-start:28px}
  .resource-guide-back{display:inline-flex;align-items:center;gap:12px;min-block-size:44px;margin-block-start:16px;color:var(--cobalt);font-size:14px}
  @media(max-width:767px){
    .community-feature{grid-template-columns:1fr;padding:28px;gap:28px}
    .resource-guide-nav>div{grid-template-columns:repeat(2,minmax(0,1fr));gap:4px 18px}
    .resource-guide-nav a{font-size:14px;min-block-size:52px}
  }
</style>
