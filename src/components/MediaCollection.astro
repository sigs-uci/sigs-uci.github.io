---
import {events,stories} from '../data';
import {href,type Locale} from '../config/site';
import {tr,formatNumber} from '../i18n/ui';
import {collectionItems,collectionPath,mediaCollections,videoDuration,albumPhotos,albumPages,albumPageSize,type MediaCollection} from '../lib/media';
import {eventHref,reviewedTranslation,isPublicStory} from '../lib/publication';
import {isPublicEvent,newestEventsFirst} from '../lib/events';
import Gallery from './Gallery.astro';
import Video from './Video.astro';
import CollectionDirectory from './CollectionDirectory.astro';
import AlbumPagination from './AlbumPagination.astro';
const {collection,locale='en',page=1}=Astro.props as {collection:MediaCollection;locale:Locale;page?:number};
const t=(text:string)=>tr(locale,text);
const items=collectionItems(collection);
const photos=albumPhotos(items,page);
const photoCount=items.filter(item=>item.kind!=='video').length;
const totalPages=albumPages(collection,items);
const allVideos=items.filter(item=>item.kind==='video');
const videos=page===1?allVideos:[];
const related=newestEventsFirst(events.filter(event=>collection.eventIds.includes(event.id)&&isPublicEvent(event)));
const readings=stories.filter(story=>story.locale===locale&&isPublicStory(story)&&story.mediaIds.some(id=>collection.mediaIds.includes(id)));
---
<div class="wrap page-body collection-page">
  <nav class="breadcrumbs" aria-label={t('Breadcrumb')}><a href={href(locale,'community')}>{t('Community')}</a><span aria-hidden="true">/</span><a href={href(locale,'community/memories')}>{t('Memories')}</a><span aria-hidden="true">/</span><span>{collection.title[locale]}</span></nav>
  <div class="collection-intro">{collection.note&&<p class="summary">{collection.note[locale]}</p>}<nav class="subnav" aria-label={t('In this collection')}>{photoCount>0&&<a href="#photographs">{t('Photographs and posters')} ({formatNumber(locale,photoCount)})</a>}{allVideos.length>0&&<a href={page===1?'#videos':`${href(locale,collectionPath(collection))}#videos`}>{t('Videos')} ({formatNumber(locale,allVideos.length)})</a>}{related.map(event=><a href={eventHref(event,locale)}>{locale==='fa'?reviewedTranslation(event.id)?.title:event.title}</a>)}</nav></div>
  {page===1&&readings.map(story=><section class="collection-reading prose"><h2>{story.title}</h2><p>{story.summary}</p><a class="text-link" href={href(locale,`community/stories/${story.slug}`)}>{t(story.kind==='document'?'Read the document':'Read the story')} <span aria-hidden="true">↗</span></a></section>)}
  {photos.length>0&&<section id="photographs" class="collection-photographs" aria-labelledby="collection-photos"><div class="collection-section-heading"><h2 id="collection-photos">{t('Photographs and posters')}</h2><p>{t('Open a photograph for a larger view.')}</p></div>{totalPages>1&&<p class="album-range"><bdi dir="ltr">{formatNumber(locale,(page-1)*albumPageSize+1)}-{formatNumber(locale,Math.min(page*albumPageSize,photoCount))}</bdi> {t('of')} {formatNumber(locale,photoCount)} {t('images')}</p>}<AlbumPagination collection={collection} page={page} total={totalPages} locale={locale}/><Gallery items={photos} locale={locale} dense photoCaptions={collection.id==='posters-and-venues'}/><AlbumPagination collection={collection} page={page} total={totalPages} locale={locale}/></section>}
  {videos.length>0&&<section id="videos" class="collection-videos" aria-labelledby="collection-videos" data-collection-videos>
    <h2 id="collection-videos">{t('Videos')}</h2>
    <nav class="collection-video-index" aria-label={t('Choose a video')}>{videos.map(item=><a href={`#${item.id}`} data-collection-video-link={item.id}><span class="collection-video-poster"><img src={item.videoPoster} width={item.width} height={item.height} alt="" loading="lazy"/><span aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" focusable="false"><path d="m8 4 12 8-12 8Z" fill="currentColor"/></svg></span><bdi dir="ltr">{videoDuration(item.duration??0,locale)}</bdi></span><span>{item.caption[locale]}</span></a>)}</nav>
    <div class="video-grid">{videos.map(item=><div class="collection-video-player" data-collection-video-player={item.id}><Video item={item} locale={locale}/></div>)}</div>
  </section>}
  <section class="section" aria-labelledby="more-collections" data-pagefind-ignore><div class="section-heading"><h2 id="more-collections">{t('Keep exploring')}</h2><a class="text-link" href={href(locale,'community/memories')}>{t('All collections')} ↗</a></div><CollectionDirectory locale={locale} collections={mediaCollections.filter(other=>other.id!==collection.id).slice(0,3)}/></section>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-collection-videos]').forEach(root=>{
    const players=Array.from(root.querySelectorAll<HTMLElement>('[data-collection-video-player]'));
    const links=Array.from(root.querySelectorAll<HTMLAnchorElement>('[data-collection-video-link]'));
    const select=(id:string)=>{
      const selected=players.find(player=>player.dataset.collectionVideoPlayer===id);
      if(!selected)return;
      players.forEach(player=>{
        player.hidden=player!==selected;
        if(player.hidden)player.querySelector('video')?.pause();
      });
      links.forEach(link=>{
        if(link.dataset.collectionVideoLink===id)link.setAttribute('aria-current','true');
        else link.removeAttribute('aria-current');
      });
    };
    const fromHash=()=>{
      const id=window.location.hash.slice(1);
      const selected=players.find(player=>player.dataset.collectionVideoPlayer===id);
      if(!selected){
        if(players[0])select(players[0].dataset.collectionVideoPlayer!);
        return;
      }
      select(id);
      selected.querySelector('figure')?.scrollIntoView({block:'start',behavior:'instant'});
    };
    root.dataset.videoSelectorReady='';
    const initial=players.find(player=>`#${player.dataset.collectionVideoPlayer}`===window.location.hash)??players[0];
    if(initial)select(initial.dataset.collectionVideoPlayer!);
    links.forEach(link=>link.addEventListener('click',event=>{
      if(event.button!==0||event.ctrlKey||event.metaKey||event.shiftKey||event.altKey)return;
      select(link.dataset.collectionVideoLink!);
    }));
    window.addEventListener('hashchange',fromHash);
    if(players.some(player=>`#${player.dataset.collectionVideoPlayer}`===window.location.hash))requestAnimationFrame(fromHash);
  });
</script>
