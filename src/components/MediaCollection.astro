---
import {events} from '../data';
import {href,type Locale} from '../config/site';
import {tr,formatNumber} from '../i18n/ui';
import {collectionItems,mediaCollections,type MediaCollection} from '../lib/media';
import {eventHref,reviewedTranslation} from '../lib/publication';
import {isPublicEvent} from '../lib/events';
import Gallery from './Gallery.astro';
import Video from './Video.astro';
import CollectionDirectory from './CollectionDirectory.astro';
const {collection,locale='en'}=Astro.props as {collection:MediaCollection;locale:Locale};
const t=(text:string)=>tr(locale,text);
const items=collectionItems(collection);
const photos=items.filter(item=>item.kind!=='video');
const videos=items.filter(item=>item.kind==='video');
const related=events.filter(event=>collection.eventIds.includes(event.id)&&isPublicEvent(event));
---
<div class="wrap page-body">
  <nav class="breadcrumbs" aria-label={t('Breadcrumb')}><a href={href(locale,'community')}>{t('Community')}</a><span aria-hidden="true">/</span><a href={href(locale,'community/memories')}>{t('Memories')}</a><span aria-hidden="true">/</span><span>{collection.title[locale]}</span></nav>
  <div class="collection-intro">{collection.note&&<p class="summary">{collection.note[locale]}</p>}<nav class="subnav" aria-label={t('In this collection')}>{photos.length>0&&<a href="#photographs">{t('Photographs and posters')} ({formatNumber(locale,photos.length)})</a>}{videos.length>0&&<a href="#videos">{t('Videos')} ({formatNumber(locale,videos.length)})</a>}{related.map(event=><a href={eventHref(event,locale)}>{locale==='fa'?reviewedTranslation(event.id)?.title:event.title}</a>)}</nav></div>
  {videos.length>0&&<section id="videos" aria-labelledby="collection-videos"><h2 id="collection-videos">{t('Videos')}</h2><div class="video-grid">{videos.map(item=><Video item={item} locale={locale}/>)}</div></section>}
  {photos.length>0&&<section id="photographs" aria-labelledby="collection-photos"><h2 id="collection-photos">{t('Photographs and posters')}</h2><Gallery items={photos} locale={locale} dense photoCaptions={collection.id==='posters-and-venues'}/></section>}
  <section class="section" aria-labelledby="more-collections" data-pagefind-ignore><div class="section-heading"><h2 id="more-collections">{t('Keep exploring')}</h2><a class="text-link" href={href(locale,'community/memories')}>{t('All collections')} ↗</a></div><CollectionDirectory locale={locale} collections={mediaCollections.filter(other=>other.id!==collection.id).slice(0,3)}/></section>
</div>
