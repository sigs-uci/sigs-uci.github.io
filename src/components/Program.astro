---
import { events, programs, type ProgramDetail } from '../data';
import { emailLink, href, type Locale } from '../config/site';
import { isPublicEvent } from '../lib/events';
import { tr } from '../i18n/ui';
import { programLinkHref } from '../lib/programs';
import EventTeaser from './EventTeaser.astro';
import '../styles/editorial.css';
const { program, locale = 'en' } = Astro.props as { program: ProgramDetail; locale: Locale };
const t = (s: string) => tr(locale, s);
const records = program.relatedEventIds.map(id => events.find(event => event.id === id && isPublicEvent(event))).filter(event => event !== undefined);
---
<div class="wrap page-body">
  <nav class="breadcrumbs" aria-label={t('Breadcrumb')}><a href={href(locale,'community')}>{t('Community')}</a><span aria-hidden="true">/</span><span>{t(program.title)}</span></nav>
  <div class="program-reading"><article class="prose"><p class="eyebrow">{t(program.periodLabel)}</p><p>{t(program.intro)}</p>{program.sections.map(section=><section><h2>{t(section.title)}</h2>{section.paragraphs.map(paragraph=><p>{t(paragraph)}</p>)}</section>)}</article>
  <aside><h2>{t('Follow this thread')}</h2><ul>{program.relatedPaths.map(link=><li><a href={programLinkHref(link,locale)}>{t(link.label)} ↗</a></li>)}</ul>{program.publicContextLinks.length>0&&<><h2>{t('Public context')}</h2><ul>{program.publicContextLinks.map(link=><li><a href={link.url}>{t(link.label)}{link.url.endsWith('.pdf')?' (PDF)':''} ↗</a></li>)}</ul></>}<p>{t('Have a program, a photograph, or a detail to add to this history?')}</p><a class="text-link" href={emailLink(`${t('SIGS program')}: ${t(program.title)}`)}>{t('Share it with SIGS')} ↗</a></aside></div>
  {records.length>0&&<section class="program-records" aria-labelledby="program-records"><h2 id="program-records">{t('In the event archive')}</h2><div class="record-directory">{records.map(event=><EventTeaser event={event} locale={locale}/>)}</div></section>}
  <section class="program-records" aria-labelledby="other-programs"><h2 id="other-programs">{t('More of life in SIGS')}</h2><nav class="subnav" aria-label={t('Other program themes')}>{programs.filter(theme=>theme.id!==program.id).map(theme=><a href={href(locale,`community/programs/${theme.id}`)}>{t(theme.name)}</a>)}</nav></section>
</div>
