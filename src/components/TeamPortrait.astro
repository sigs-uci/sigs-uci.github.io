---
import { media, people } from '../data';
import type { Locale } from '../config/site';

interface Props {
  personId: string;
  locale: Locale;
  compact?: boolean;
  portraitId?: string | null;
}

const { personId, locale, compact = false, portraitId } = Astro.props;
const person = people.find(record => record.id === personId);
const portrait = media.find(item => item.id === (portraitId ?? person?.portrait)
  && item.kind !== 'video' && item.publication === 'published' && item.rights === 'approved');
const initials = person?.name.split(/\s+/).map(part => part[0]).slice(0, 2).join('') ?? '';
---
<figure class:list={['team-portrait', { compact }]} aria-hidden={!portrait ? 'true' : undefined}>
  {portrait ? <img src={portrait.src} width={portrait.width} height={portrait.height}
    loading="lazy" decoding="async" alt={portrait.alt[locale] ?? portrait.alt.en}
    style={`object-position:${portrait.focalPoint[0] * 100}% ${portrait.focalPoint[1] * 100}%`} />
    : <span class="team-initials" lang="en" dir="ltr">{initials}</span>}
</figure>

<style>
  .team-portrait{--portrait-size:128px;margin:0 0 20px;inline-size:var(--portrait-size);block-size:var(--portrait-size);aspect-ratio:1;flex:none;overflow:hidden;border-radius:12px;background:var(--canvas)}
  .team-portrait img,.team-initials{display:block;width:100%;height:100%;max-width:none;object-fit:cover}
  .team-initials{display:grid;place-items:center;background:var(--ice);color:var(--navy);font-family:Manrope,Arial,sans-serif;font-size:36px;font-weight:600;letter-spacing:-.04em;border:1px solid var(--line)}
  .compact{margin:0}
  @media(max-width:540px){.team-portrait{--portrait-size:96px}.team-initials{font-size:30px}}
</style>
