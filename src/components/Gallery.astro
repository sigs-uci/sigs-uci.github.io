---
import {events,type MediaRecord} from '../data';
import type {Locale} from '../config/site';
import {tr} from '../i18n/ui';
import {isPublicEvent} from '../lib/events';
import {eventHref,eventLocale,reviewedTranslation} from '../lib/publication';
import '../styles/editorial.css';
import '../styles/media.css';
const {items,locale='en',dense=false} = Astro.props as {items:MediaRecord[];locale:Locale;dense?:boolean};
const t=(s:string)=>tr(locale,s);
---
{items.length>0&&<div data-gallery><div class:list={['gallery-grid',{dense}]}>{items.map((item)=>{const event=events.find(event=>event.id===item.eventId&&isPublicEvent(event));const language=event?eventLocale(event,locale):undefined;return <figure id={`image-${item.id}`} data-media-kind={item.kind??'photo'}><a href={item.src} data-gallery-item data-caption={`${item.caption[locale]??item.caption.en??''} ${t(item.credit)}`}><img src={item.thumbnail??item.src} width={item.width} height={item.height} alt={item.alt[locale]??item.alt.en??''} lang={item.alt[locale]?locale:'en'} loading="lazy" style={`object-position:${item.focalPoint[0]*100}% ${item.focalPoint[1]*100}%`} /></a><figcaption><span lang={item.caption[locale]?locale:'en'}>{item.caption[locale]??item.caption.en}</span> <span dir="auto">{t(item.credit)}</span>{event&&<p><a href={eventHref(event,locale)} hreflang={language}>{t('View event')}: <span lang={language}>{language==='fa'?reviewedTranslation(event.id)?.title:event.title}</span></a>{locale==='fa'&&language==='en'&&<span> ({t('English record')})</span>}</p>}</figcaption></figure>;})}</div><dialog class="gallery-dialog" aria-label={t('Image viewer')}><header><h2>{t('Photographs and posters')}</h2><button type="button" data-gallery-close autofocus>{t('Close')}</button></header><img src={items[0].thumbnail??items[0].src} loading="lazy" alt="" data-gallery-image /><p data-gallery-caption></p><p class="sr-only" data-gallery-status role="status" aria-live="polite" aria-atomic="true"></p><nav aria-label={t('Image controls')}><button type="button" data-gallery-prev>{t('Previous image')}</button><span data-gallery-count></span><button type="button" data-gallery-next>{t('Next image')}</button></nav></dialog></div>}
<script>
  import {setupGalleryLinks} from '../scripts/gallery-links';
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach(root=>setupGalleryLinks(root));
</script>
