---
import {events} from '../data';
import {effectiveDay,formatDate,isPublicEvent} from '../lib/events';
import {href,type Locale} from '../config/site';
import {tr} from '../i18n/ui';
import {eventHref,eventLocale,reviewedTranslation} from '../lib/publication';
import '../styles/events.css';

const {locale='en',archive=false}=Astro.props as {locale:Locale;archive:boolean};
const t=(text:string)=>tr(locale,text);
const number=(value:number)=>new Intl.NumberFormat(locale==='fa'?'fa-IR':'en-US',{useGrouping:false}).format(value);
const recordCount=(value:number)=>`${number(value)} ${t(value===1?'record':'records')}`;
const records=events.filter(isPublicEvent).sort((a,b)=>(effectiveDay(b)??'').localeCompare(effectiveDay(a)??''));
const recordYear=(event:typeof records[number])=>(effectiveDay(event)??String(event.date.contextYear??'')).slice(0,4);
const years=[...new Set(records.map(recordYear))].filter(Boolean).sort((a,b)=>Number(b)-Number(a));
const groups=[...years,...(records.some(event=>!recordYear(event))?['']:[])].map(year=>({year,records:records.filter(event=>recordYear(event)===year)}));
const categories=[...new Set(records.map(event=>event.category))];
const labels:Record<string,string>={culture:'Culture','film-poetry':'Film & poetry',community:'Social & community',newcomers:'Newcomers',professional:'Professional connections'};
const historical=records.filter(event=>event.archiveLabel);
const archiveYears=years.filter(year=>historical.some(event=>recordYear(event)===year));
const documented=historical.filter(event=>event.archiveLabel==='Documented gathering').length;
const announcements=historical.filter(event=>event.archiveLabel==='Archived announcement').length;
const filterLink=(query:Record<string,string>)=>`${href(locale,archive?'events/archive':'events')}?${new URLSearchParams(query)}#event-results`;
---

<div class="wrap page-body events-explorer" data-events data-default-period={archive?'past':'all'} data-locale={locale} data-messages={JSON.stringify({records:t('filtered records'),record:t('filtered record'),inMonth:t('in this month'),yearRecords:t('records in this year'),yearRecord:t('record in this year'),english:t('English record'),monthEmpty:t('No events match this month. Try another month or reset the filters.'),upcomingTitle:t('The next gathering will appear here.'),upcomingCopy:t('Details will be posted when confirmed. Get in touch with the team or explore past gatherings.'),emptyTitle:t('No matching events.'),emptyCopy:t('Try another year or topic, or reset the filters.')})}>
  <section id="event-results" tabindex="-1" aria-labelledby="event-results-title">
    <h2 class="sr-only" id="event-results-title">{t('The event records')}</h2>
    <div data-enhanced hidden>
      <form class="filters" id="event-filters" data-event-filters>
        <div class="field events-search"><label for="event-query">{t('Find an event')}</label><input id="event-query" name="q" type="search" placeholder={t('Title, program, or place')} /></div>
        <div class="field"><label for="period">{t('When')}</label><select id="period" name="period"><option value="all" selected={!archive}>{t('All dates')}</option><option value="upcoming">{t('Current & upcoming')}</option><option value="past" selected={archive}>{t('Past')}</option></select></div>
        <div class="field"><label for="year">{t('Year')}</label><select id="year" name="year"><option value="">{t('All years')}</option>{years.map(year=><option value={year}>{number(Number(year))}</option>)}</select></div>
        <div class="field"><label for="category">{t('Topic')}</label><select id="category" name="category"><option value="">{t('All topics')}</option>{categories.map(category=><option value={category}>{t(labels[category])}</option>)}</select></div>
      </form>
      <div class="results-toolbar"><span data-count role="status" aria-live="polite"></span><div class="events-result-actions"><button class="events-reset" type="reset" form="event-filters">{t('Reset')}</button><div class="view-switch" aria-label={t('Event view')}><button type="button" data-view="list" aria-pressed="true">{t('List')}</button><button type="button" data-view="calendar" aria-pressed="false">{t('Calendar')}</button></div></div></div>
    </div>
    <noscript><p class="notice">{t('All published event records are listed below. Use the year archive links or search this page with your browser. Interactive filters and the calendar need JavaScript.')} <a href="#event-years">{t('Browse the archive by year')}</a></p></noscript>

    <div data-event-list>{groups.map(group=><section class="events-year-group" data-event-year-group data-year={group.year} aria-labelledby={`records-${group.year||'undated'}`}><header class="events-year-heading"><h3 id={`records-${group.year||'undated'}`}>{group.year?number(Number(group.year)):t('Year not recorded')}</h3><p data-year-count>{number(group.records.length)} {t(group.records.length===1?'record in this year':'records in this year')}</p></header>{group.records.map(event=>{
      const day=effectiveDay(event);
      const date=day?new Date(`${day}T12:00:00Z`):null;
      const language=eventLocale(event,locale);
      const translation=language==='fa'?reviewedTranslation(event.id):undefined;
      const title=translation?.title??event.title;
      const summary=translation?.summary??event.summary;
      return <article class="event-row" data-event-row data-id={event.id} data-date={day??''} data-year={event.date.contextYear??''} data-start={event.startInstant??''} data-end={event.endInstant??''} data-time-zone={event.timeZone??''} data-all-day-start={event.allDay?.start??''} data-all-day-end={event.allDay?.end??''} data-category={event.category} data-category-label={t(labels[event.category])} data-state={event.eventState} data-title={title} data-summary={summary} data-venue={event.venue?t(event.venue):''} data-url={eventHref(event,locale)} data-record-locale={language}>
        <time class="event-date" datetime={day??undefined} aria-label={formatDate(event,locale)}>{date?<><strong>{number(date.getUTCDate())}</strong>{' '}<span>{new Intl.DateTimeFormat(locale==='fa'?'fa-IR-u-ca-gregory':'en',{month:'short',timeZone:'UTC'}).format(date)}</span>{' '}<span class="event-date-year">{number(date.getUTCFullYear())}</span></>:<span class="event-date-unknown">{formatDate(event,locale)}</span>}</time>
        <div class="event-record-copy"><div class="event-record-heading"><h4 data-event-title><a href={eventHref(event,locale)} lang={language}>{title}</a></h4><span class="status">{t(['cancelled','postponed','rescheduled'].includes(event.eventState)?event.eventState:event.archiveLabel??event.eventState)}</span></div><p class="event-record-meta"><span>{t(labels[event.category])}</span><span aria-hidden="true">·</span><span>{t(event.venue??'Venue not recorded')}</span></p><p class="event-record-summary" lang={language}>{summary}</p>{event.timeDisplay&&<p class="event-record-time">{t('Advertised time')}: <bdi>{t(event.timeDisplay)}</bdi></p>}{locale==='fa'&&language==='en'&&<span class="event-record-language">{t('English record')}</span>}</div>
      </article>;
    })}</section>)}</div>
    <div class="result-empty" data-no-results hidden><h2 data-empty-title>{t('No matching events.')}</h2><p data-empty-copy>{t('Try another year or topic, or reset the filters.')}</p><a class="text-link" href={filterLink({period:'all'})} data-event-shortcut>{t('Show all records')} <span aria-hidden="true">↗</span></a><a class="text-link" href={href(locale,'join')}>{t('Connect with SIGS')} <span aria-hidden="true">↗</span></a></div>
    <section data-calendar hidden aria-label={t('Event calendar')}><div class="calendar-toolbar"><button type="button" data-month-prev>{t('Previous month')}</button><h2 data-month-title aria-live="polite"></h2><button type="button" data-month-next>{t('Next month')}</button></div><table class="calendar"><caption class="sr-only">{t('Calendar with event links')}</caption><thead><tr>{['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(day=><th scope="col"><span class="weekday-full">{t(day)}</span><abbr class="weekday-short" title={t(day)} aria-label={t(day)}>{locale==='fa'?t(day).charAt(0):t(day)}</abbr></th>)}</tr></thead><tbody data-calendar-body></tbody></table><p class="calendar-caption">{t('Dates with events link to their details. The corresponding agenda below includes the full titles.')}</p><div class="calendar-agenda" data-calendar-agenda></div></section>
  </section>

  {archiveYears.length>0&&<details class="events-year-directory" id="event-years"><summary>{t('Browse the archive by year')}</summary><nav class="events-years" aria-label={t('Browse the archive by year')}><ul>{archiveYears.map(year=><li><a href={href(locale,`events/archive/${year}`)} hreflang={locale}><span>{number(Number(year))}</span><small>{recordCount(historical.filter(event=>recordYear(event)===year).length)}</small></a></li>)}</ul></nav></details>}

  <section class="events-evidence" id="archive-labels" aria-labelledby="archive-labels-title"><h2 id="archive-labels-title">{t('How to read the archive')}</h2><dl><div><dt>{number(documented)} {t('documented gatherings')}</dt><dd>{t('These records have supporting retrospective, media, or reported occurrence evidence. Their individual pages explain the context.')}</dd></div><div><dt>{number(announcements)} {t('archived announcements')}</dt><dd>{t('These records preserve what was advertised. They do not establish that every part of the program took place.')}</dd></div></dl><p>{t('Dates use the campus calendar. Historical advertised times retain their original context. Passing time alone does not turn an announcement into a completed event.')}</p></section>
</div>
<script>
  import '../scripts/events';
</script>
