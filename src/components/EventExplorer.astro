---
import {events} from '../data';
import {formatDate, isPublicEvent} from '../lib/events';
import {href, type Locale} from '../config/site';
import {tr} from '../i18n/ui';
import {eventHref,eventLocale,reviewedTranslation} from '../lib/publication';
const {locale='en',archive=false}=Astro.props as {locale:Locale;archive:boolean};
const t=(s:string)=>tr(locale,s);
const records=events.filter(isPublicEvent).sort((a,b)=>(b.date.value??'').localeCompare(a.date.value??''));
const categories=[...new Set(records.map(e=>e.category))];
const labels:Record<string,string>={culture:'Culture','film-poetry':'Film & poetry',community:'Social & community',newcomers:'Newcomers',professional:'Professional connections'};
const years=[...new Set(records.map(e=>(e.date.value??String(e.date.contextYear??'')).slice(0,4)))].filter(Boolean);
---
<div class="wrap page-body" data-events data-default-period={archive?'past':'upcoming'} data-locale={locale} data-messages={JSON.stringify({records:t('filtered records'),record:t('filtered record'),inMonth:t('in this month'),monthEmpty:t('No events match this month. Try another month or reset the filters.'),upcomingTitle:t('The next gathering will appear here.'),upcomingCopy:t('Details will be posted when confirmed. Get in touch with the team or explore past gatherings.'),emptyTitle:t('No matching events.'),emptyCopy:t('Try another year or topic, or reset the filters.')})}>
<p class="quiet">{t('All dates are shown in the campus calendar. Timed campus events use America/Los_Angeles. Historical advertised times retain their original context.')}</p>
<div data-enhanced hidden><form class="filters" data-event-filters><div class="field"><label for="period">{t('When')}</label><select id="period" name="period"><option value="upcoming">{t('Upcoming')}</option><option value="past">{t('Past')}</option><option value="all">{t('All dates')}</option></select></div><div class="field"><label for="year">{t('Year')}</label><select id="year" name="year"><option value="">{t('All years')}</option>{years.map(y=><option value={y}>{y}</option>)}</select></div><div class="field"><label for="category">{t('Topic')}</label><select id="category" name="category"><option value="">{t('All topics')}</option>{categories.map(c=><option value={c}>{t(labels[c])}</option>)}</select></div><div class="field"><label for="event-query">{t('Find an event')}</label><input id="event-query" name="q" type="search" placeholder={t('Title or place')} /></div><button class="button light" type="reset">{t('Reset')}</button></form><div class="results-toolbar"><span data-count role="status" aria-live="polite"></span><div class="view-switch" aria-label={t('Event view')}><button data-view="list" aria-pressed="true">{t('List')}</button><button data-view="calendar" aria-pressed="false">{t('Calendar')}</button></div></div></div>
<noscript><p class="notice">{t('All published event records are listed below. Search this page or use the dated event links to browse the archive.')}</p></noscript>
<div data-event-list>{records.map(event=>{const date=event.date.value?new Date(`${event.date.value}T12:00:00Z`):null;const language=eventLocale(event,locale);const translation=language==='fa'?reviewedTranslation(event.id):undefined;const title=translation?.title??event.title;return <article class="event-row" data-event-row data-id={event.id} data-date={event.allDay?.start??event.date.value??''} data-year={event.date.contextYear??''} data-start={event.startInstant??''} data-all-day-start={event.allDay?.start??''} data-all-day-end={event.allDay?.end??''} data-category={event.category} data-state={event.eventState} data-title={title} data-summary={translation?.summary??event.summary} data-venue={event.venue??''} data-url={eventHref(event,locale)}><time class="event-date" datetime={event.date.value??undefined}>{date?<><strong>{new Intl.DateTimeFormat(locale==='fa'?'fa-IR-u-ca-gregory':'en',{day:'numeric',month:'short',timeZone:'UTC'}).format(date)}</strong><span>{date.getUTCFullYear()}</span></>:formatDate(event,locale)}</time><div><h2><a href={eventHref(event,locale)} lang={language}>{title}</a></h2><p>{t(event.venue??'Venue not recorded')} · {t(labels[event.category])}</p>{locale==='fa'&&language==='en'&&<span>{t('English record')}</span>}</div><span class="status">{t(['cancelled','postponed','rescheduled'].includes(event.eventState)?event.eventState:event.archiveLabel??event.eventState)}</span></article>})}</div>
<div class="result-empty" data-no-results hidden><h2 data-empty-title>{t('No matching events.')}</h2><p data-empty-copy>{t('Try another year or topic, or reset the filters.')}</p><a class="text-link" href={href(locale,'events/archive')}>{t('Browse past gatherings')} <span aria-hidden="true">↗</span></a><a class="text-link" href={href(locale,'join')}>{t('Connect with SIGS')} <span aria-hidden="true">↗</span></a></div>
<section data-calendar hidden aria-label={t('Event calendar')}><div class="calendar-toolbar"><button type="button" data-month-prev>{t('Previous month')}</button><h2 data-month-title aria-live="polite"></h2><button type="button" data-month-next>{t('Next month')}</button></div><table class="calendar"><caption class="sr-only">{t('Calendar with event links')}</caption><thead><tr>{['Sun','Mon','Tue','Wed','Thu','Fri','Sat'].map(d=><th scope="col">{t(d)}</th>)}</tr></thead><tbody data-calendar-body></tbody></table><p class="calendar-caption">{t('Dates with events link to their details. The corresponding agenda below includes the full titles.')}</p><div class="calendar-agenda" data-calendar-agenda></div></section>
<p class="archive-note">{t('An archived announcement records advertised plans. A documented gathering has supporting occurrence evidence. Passing time alone does not turn an announcement into a completed event.')}</p>
</div>
<script>
  import '../scripts/events';
</script>
