---
import {events,media,type StoryRecord} from '../data';
import {href,type Locale} from '../config/site';
import Gallery from './Gallery.astro';
import {tr} from '../i18n/ui';
import {isPublicEvent} from '../lib/events';
import {eventHref,eventLocale,reviewedTranslation} from '../lib/publication';
const {story,locale='en'}=Astro.props as {story:StoryRecord;locale:Locale};const t=(s:string)=>tr(locale,s);
const related=events.filter(e=>story.relatedEventIds.includes(e.id)&&isPublicEvent(e));
const images=media.filter(m=>story.mediaIds.includes(m.id)&&m.publication==='published'&&m.rights==='approved');
---
<article class="wrap page-body"><div class="prose"><p class="eyebrow">{t(story.kind==='yearbook'?'A year in SIGS':'Community story')}</p><h1 data-pagefind-meta="title">{story.title}</h1><p>{story.summary}</p><p><time datetime={story.publishedOn}>{new Intl.DateTimeFormat(locale==='fa'?'fa-IR-u-ca-gregory':'en',{dateStyle:'long',timeZone:'UTC'}).format(new Date(`${story.publishedOn}T12:00:00Z`))}</time>{story.credit&&` · ${story.credit}`}</p>{story.body.map(text=><p>{text}</p>)}</div><Gallery items={images} locale={locale}/>{related.length>0&&<section class="event-context"><h2>{t('Gatherings in this story')}</h2><div class="related">{related.map(event=><a href={eventHref(event,locale)} lang={eventLocale(event,locale)}><h3>{eventLocale(event,locale)==='fa'?reviewedTranslation(event.id)?.title:event.title}</h3><p>{event.archiveLabel}</p>{locale==='fa'&&eventLocale(event,locale)==='en'&&<span>{t('English record')}</span>}</a>)}</div></section>}<a class="text-link" href={href(locale,'join')}>{t('Take part in SIGS')} ↗</a></article>
