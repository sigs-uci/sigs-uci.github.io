---
import {href,emailLink,type Locale} from '../config/site';
import {tr,formatNumber} from '../i18n/ui';
import {publicVideos,publicMedia,mediaCollections,collectionItems,collectionPath} from '../lib/media';
import Gallery from './Gallery.astro';
import Video from './Video.astro';
import CollectionDirectory from './CollectionDirectory.astro';
import '../styles/media.css';
const {locale='en',videosOnly=false}=Astro.props as {locale:Locale;videosOnly?:boolean};
const t=(text:string)=>tr(locale,text);
const historical=publicMedia.filter(item=>['poetry-night-2019-photo','tales-2016-poster','yalda-2025-flyer'].includes(item.id));
const videoCollections=mediaCollections.map(collection=>({collection,videos:collectionItems(collection).filter(item=>item.kind==='video')})).filter(group=>group.videos.length>0);
---
<div class="wrap page-body">
  <nav class="media-subnav subnav" aria-label={t('Community media')}><a href={href(locale,'community/memories')} aria-current={!videosOnly?'page':undefined}>{t('Photo collections')}</a><a href={href(locale,'community/videos')} aria-current={videosOnly?'page':undefined}>{t('Videos')}</a><a href={href(locale,'events/archive')}>{t('Event archive')}</a></nav>
  {videosOnly?<><h2>{t('Short films from our gatherings.')}</h2><p class="prose">{t('Celebrations, outings and evenings together, with written descriptions in English and Persian.')}</p><nav class="subnav" aria-label={t('Choose a video')}>{videoCollections.map(({collection})=><a href={`#videos-${collection.id}`}>{collection.title[locale]}</a>)}</nav>{videoCollections.map(({collection,videos})=><section class="section" id={`videos-${collection.id}`} aria-labelledby={`heading-${collection.id}`}><div class="section-heading"><h2 id={`heading-${collection.id}`}>{collection.title[locale]}</h2><a href={href(locale,collectionPath(collection))}>{t('Browse the full album')} <span aria-hidden="true">↗</span></a></div><p class="prose">{collection.description[locale]}</p><div class="video-grid">{videos.map(item=><Video item={item} locale={locale}/>)}</div></section>)}</>:<>
    <section class="media-opening"><div><p class="eyebrow">{t('Our photo and video archive')}</p><h2>{t('Life in SIGS, in photos and videos')}</h2><p>{t('Explore Nowruz celebrations, a poetry night, and outings by the water through our photos and videos.')}</p><p class="media-total">{formatNumber(locale,publicMedia.filter(item=>item.kind!=='video').length)} {t('images')} · {formatNumber(locale,publicVideos.length)} {t('videos')} · {formatNumber(locale,mediaCollections.length)} {t('collections')}</p></div><a class="button primary" href={href(locale,'community/videos')}>{t('Watch the videos')} ↗</a></section>
    <nav class="video-strip" aria-label={t('Choose a video')}>{publicVideos.map(item=><a href={`${href(locale,'community/videos')}#${item.id}`}><span class="video-thumb"><img src={item.videoPoster} width={item.width} height={item.height} alt="" loading="lazy"/><span aria-hidden="true">▶</span></span><span>{item.caption[locale]}</span></a>)}</nav>
    <section class="section" aria-labelledby="photo-collections"><div class="section-heading"><h2 id="photo-collections">{t('Photo collections')}</h2></div><CollectionDirectory locale={locale}/></section>
    <section aria-labelledby="dated-media"><h2 id="dated-media">{t('Posters and a poetry night')}</h2><p class="prose">{t('Read about the 2019 poetry night, the Tales screening announcement, and the invitation to Yalda 2025.')}</p><Gallery items={historical} locale={locale} dense/></section>
  </>}
  <section class="notice"><h2>{t('Help put a name to a memory.')}</h2><p>{t('Know an event date, a photographer, or a detail we should correct? Send the collection link and tell us what may be published. You can also ask about an image or request its removal.')}</p><a class="text-link" href={emailLink(t('SIGS media correction'))}>{t('Contact SIGS')}</a></section>
</div>
