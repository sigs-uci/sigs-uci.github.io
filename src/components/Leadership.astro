---
import {boardTerms, media, organization, people} from '../data';
import {href,type Locale} from '../config/site';
import {tr,formatTerm} from '../i18n/ui';
const {locale='en',termId=organization.currentBoardTermId}=Astro.props as {locale:Locale;termId?:string};
const t=(s:string)=>tr(locale,s);
const term=boardTerms.find(term=>term.id===termId)!;
const groups=[['board','Board'],['support','Support Team'],['advisor','Advisor']];
---
<div class="wrap page-body"><nav class="roster-nav" aria-label={t('Team terms')}>{boardTerms.map(board=><a href={href(locale,`about/leadership/${board.id}`)} aria-current={term.id===board.id?'page':undefined}><bdi dir="ltr">{formatTerm(locale,board.term)}</bdi> · {t(board.status==='current'?'Current team':'Previous team')}</a>)}</nav>
<p class="quiet">{t(term.status==='current'?'Meet the people serving SIGS in the current term.':'These roles and contact links belong to the previous term.')} {t('For organization matters, use')} <a href="mailto:sigs@uci.edu"><bdi>sigs@uci.edu</bdi></a>.</p>
{term.people.length===0 && <p class="notice">{term.status==='current'&&organization.currentBoardNotice?organization.currentBoardNotice:t('Contact SIGS for team information for this term.')}</p>}
{groups.map(([id,label])=>{const members=term.people.filter(member=>member.group===id).sort((a,b)=>a.displayOrder-b.displayOrder);return members.length>0&&<section class="roster-group"><h2>{t(label)}</h2><div class="people-list">{members.map(member=>{const person=people.find(person=>person.id===member.personId);const portrait=media.find(item=>item.id===(member.portrait??person?.portrait)&&item.publication==='published'&&item.rights==='approved');const bio=member.bio??person?.bio;return <article class="person" id={member.personId}>{portrait&&<figure class="person-portrait"><img src={portrait.src} width={portrait.width} height={portrait.height} loading="lazy" alt={portrait.alt[locale]??portrait.alt.en??''} style={`object-position:${portrait.focalPoint[0]*100}% ${portrait.focalPoint[1]*100}%`} /><figcaption>{portrait.caption[locale]??portrait.caption.en} {t(portrait.credit)}</figcaption></figure>}<h3><bdi lang="en" dir="ltr">{member.name}</bdi></h3><p>{t(member.role)}</p>{bio&&<p>{t(bio)}</p>}{member.telegramUrl&&<a href={member.telegramUrl} aria-label={`${t('Contact')} ${member.name} ${t('on Telegram')}`}><bdi>{member.telegramUrl.split('/').pop()}</bdi> <span>{t('on Telegram')} ↗</span></a>}</article>})}</div></section>})}
<p class="archive-note">{t('Individual contacts are listed for their term. For joining the SIGS community, start with the organization email.')}</p></div>
