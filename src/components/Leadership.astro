---
import {boardTerms, organization, people} from '../data';
import {href,type Locale} from '../config/site';
import {tr,formatTerm} from '../i18n/ui';
import TeamPortrait from './TeamPortrait.astro';
const {locale='en',termId=organization.currentBoardTermId}=Astro.props as {locale:Locale;termId?:string};
const t=(s:string)=>tr(locale,s);
const term=boardTerms.find(term=>term.id===termId)!;
const groups=[['board','Board'],['support','Support Team'],['advisor','Advisor']];
---
<div class="wrap page-body"><nav class="roster-nav" aria-label={t('Team terms')}>{boardTerms.map(board=><a href={href(locale,`about/leadership/${board.id}`)} aria-current={term.id===board.id?'page':undefined}><bdi dir="ltr">{formatTerm(locale,board.term)}</bdi> · {t(board.status==='current'?'Current team':'Previous team')}</a>)}</nav>
<p class="quiet">{t(term.status==='current'?'Meet the people serving SIGS in the current term.':'These roles belong to the previous term.')} {t('For organization matters, use')} <a href="mailto:sigs@uci.edu"><bdi>sigs@uci.edu</bdi></a>.</p>
{term.people.length===0 && <p class="notice">{term.status==='current'&&organization.currentBoardNotice?organization.currentBoardNotice:t('Contact SIGS for team information for this term.')}</p>}
{groups.map(([id,label])=>{const members=term.people.filter(member=>member.group===id).sort((a,b)=>a.displayOrder-b.displayOrder);return members.length>0&&<section class="roster-group"><h2>{t(label)}</h2><div class="people-list">{members.map(member=>{const person=people.find(person=>person.id===member.personId);const bio=member.bio??person?.bio;const major=term.status==='current'?person?.major?.[locale]:undefined;return <article class="person" id={member.personId}><TeamPortrait personId={member.personId} portraitId={member.portrait} locale={locale} /><h3><bdi lang="en" dir="ltr">{member.name}</bdi></h3><p>{t(member.role)}</p>{major&&<p class="person-major">{major}</p>}{bio&&<p>{t(bio)}</p>}{person?.linkedinUrl&&<a href={person.linkedinUrl} aria-label={`${member.name}: ${t('View LinkedIn profile')}`}><span>{t('LinkedIn profile')}</span> <span aria-hidden="true">↗</span></a>}</article>})}</div></section>})}
<p class="archive-note">{t('For organization matters or joining SIGS, contact the organization email.')}</p></div>

<style>
  .person .person-major{color:var(--ink);font-size:14px;line-height:1.7;max-width:40ch;overflow-wrap:anywhere}
</style>
